diff --git a/crates/slot-ui/src/media.rs b/crates/slot-ui/src/media.rs
new file mode 100644
index 0000000..71ede2d
--- /dev/null
+++ b/crates/slot-ui/src/media.rs
@@ -0,0 +1,233 @@
+//! The NES and SNES carts. Ported from fragilesilver/slot-fragile@f2da56a,
+//! crates/slot-ui/src/media.rs (itself after cloudwithax/unslot), cut to the two
+//! cartridge systems. The shells are Fragile's, drawn by its
+//! `tools/fragile/media/draw_carts.py`, which prints their label boxes below.
+
+use std::sync::OnceLock;
+
+use slot_store::Platform;
+
+use crate::bitmaps;
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub enum Media {
+    Nes,
+    Snes,
+}
+
+struct Art {
+    png: &'static [u8],
+    w: u32,
+    h: u32,
+    label: (u32, u32, u32, u32),
+    /// Printed on the shell in its own colours, so the game's colour does not tint it.
+    sticker: Option<(u32, u32, u32, u32)>,
+    colour: [u8; 3],
+    /// The corners of the label's recess, so a label does not print past them.
+    radius: f32,
+    rounded_top: bool,
+}
+
+const ART: [Art; Media::COUNT] = [
+    Art {
+        png: include_bytes!("../../../assets/nes_neutral.png"),
+        w: 304,
+        h: 343,
+        label: (122, 2, 143, 232),
+        sticker: None,
+        colour: [0x8a, 0x8a, 0x8e],
+        radius: 3.5,
+        rounded_top: false,
+    },
+    Art {
+        png: include_bytes!("../../../assets/snes_neutral.png"),
+        w: 360,
+        h: 229,
+        label: (68, 2, 223, 99),
+        sticker: Some((68, 2, 223, 99)),
+        colour: [0x9a, 0x99, 0xa0],
+        radius: 3.0,
+        rounded_top: true,
+    },
+];
+
+/// How tall a cart may sit in the slot: the Game Boy pak's seated height.
+const SEATED_MAX_H: u32 = 259;
+
+impl Media {
+    pub const COUNT: usize = 2;
+    pub const ALL: [Media; Media::COUNT] = [Media::Nes, Media::Snes];
+
+    /// What a platform's games come on, or None for the Game Boy family's own moulds.
+    pub fn of(platform: Platform) -> Option<Media> {
+        match platform {
+            Platform::Gba | Platform::Gb | Platform::Gbc => None,
+            Platform::Nes => Some(Media::Nes),
+            Platform::Snes => Some(Media::Snes),
+        }
+    }
+
+    pub fn index(self) -> usize {
+        self as usize
+    }
+
+    fn art(self) -> &'static Art {
+        &ART[self.index()]
+    }
+
+    pub fn size(self) -> (u32, u32) {
+        (self.art().w, self.art().h)
+    }
+
+    /// The label box, x, y, w, h in the shell's pixels.
+    pub fn label(self) -> (u32, u32, u32, u32) {
+        self.art().label
+    }
+
+    /// The part of the shell that keeps its own colours, x, y, w, h.
+    pub fn sticker(self) -> Option<(u32, u32, u32, u32)> {
+        self.art().sticker
+    }
+
+    /// The plastic a game gets when nothing names another colour for it.
+    pub fn colour(self) -> [u8; 3] {
+        self.art().colour
+    }
+
+    /// The size it is drawn at once it sits in the slot: as wide as a seated cart, unless that
+    /// would stand taller than a seated Game Boy pak.
+    pub fn seated(self, seated_w: u32) -> (u32, u32) {
+        let (w, h) = self.size();
+        let tall = (seated_w * h + w / 2) / w;
+        if tall <= SEATED_MAX_H {
+            return (seated_w, tall);
+        }
+        ((SEATED_MAX_H * w + h / 2) / h, SEATED_MAX_H)
+    }
+
+    /// The neutral shell, decoded once.
+    pub fn neutral(self) -> &'static [u8] {
+        static SHELLS: [OnceLock<Vec<u8>>; Media::COUNT] =
+            [const { OnceLock::new() }; Media::COUNT];
+        let art = self.art();
+        bitmaps::load(art.png, art.w, art.h, &SHELLS[self.index()])
+    }
+
+    /// The shell's coverage, from the render's alpha.
+    pub fn mask(self) -> &'static [u8] {
+        static MASKS: [OnceLock<Vec<u8>>; Media::COUNT] = [const { OnceLock::new() }; Media::COUNT];
+        MASKS[self.index()]
+            .get_or_init(|| self.neutral().iter().skip(3).step_by(4).copied().collect())
+    }
+
+    /// Where on the label box the label may print: inside the recess's rounded corners.
+    /// Coverage a pixel, row by row over the label box.
+    pub fn label_mask(self) -> &'static [u8] {
+        static MASKS: [OnceLock<Vec<u8>>; Media::COUNT] = [const { OnceLock::new() }; Media::COUNT];
+        MASKS[self.index()].get_or_init(|| {
+            let art = self.art();
+            let (_, _, w, h) = art.label;
+            rounded(w, h, art.radius, art.rounded_top)
+        })
+    }
+}
+
+/// A w by h box with its bottom corners -- and its top ones, if asked -- rounded to `r`.
+fn rounded(w: u32, h: u32, r: f32, top: bool) -> Vec<u8> {
+    let (fw, fh) = (w as f32, h as f32);
+    let mut out = Vec::with_capacity((w * h) as usize);
+    for y in 0..h {
+        let py = y as f32 + 0.5;
+        for x in 0..w {
+            let px = x as f32 + 0.5;
+            let cx = if px < r {
+                Some(r)
+            } else if px > fw - r {
+                Some(fw - r)
+            } else {
+                None
+            };
+            let cy = if top && py < r {
+                Some(r)
+            } else if py > fh - r {
+                Some(fh - r)
+            } else {
+                None
+            };
+            let cov = match (cx, cy) {
+                (Some(cx), Some(cy)) => (r - (px - cx).hypot(py - cy) + 0.5).clamp(0.0, 1.0),
+                _ => 1.0,
+            };
+            out.push((cov * 255.0 + 0.5) as u8);
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_home_consoles_have_media() {
+        for p in Platform::ALL {
+            assert_eq!(Media::of(p).is_some(), p.console(), "{p:?}");
+        }
+    }
+
+    #[test]
+    fn every_shell_decodes_at_the_size_it_claims_and_its_label_fits() {
+        for m in Media::ALL {
+            let (w, h) = m.size();
+            assert_eq!(m.neutral().len(), (w * h * 4) as usize, "{m:?}");
+            let (lx, ly, lw, lh) = m.label();
+            assert!(lx + lw <= w && ly + lh <= h, "{m:?} label leaves the shell");
+            assert_eq!(m.label_mask().len(), (lw * lh) as usize, "{m:?}");
+        }
+    }
+
+    #[test]
+    fn a_shell_is_solid_at_its_label_and_clear_past_its_corners() {
+        for m in Media::ALL {
+            let (w, _) = m.size();
+            let (lx, ly, lw, lh) = m.label();
+            let at = |x: u32, y: u32| m.mask()[(y * w + x) as usize];
+            assert_eq!(
+                at(lx + lw / 2, ly + lh / 4),
+                255,
+                "{m:?} has a hole in its label"
+            );
+            assert_eq!(at(0, 0), 0, "{m:?} fills its top left corner");
+        }
+    }
+
+    #[test]
+    fn a_label_prints_inside_its_recess_corners() {
+        for m in Media::ALL {
+            let (_, _, w, h) = m.label();
+            let mask = m.label_mask();
+            let at = |x: u32, y: u32| mask[(y * w + x) as usize];
+            assert_eq!(at(w / 2, h / 2), 255, "{m:?}");
+            assert_eq!(at(0, h - 1), 0, "{m:?} prints past its bottom left corner");
+            assert_eq!(
+                at(w - 1, h - 1),
+                0,
+                "{m:?} prints past its bottom right corner"
+            );
+        }
+        assert_eq!(
+            Media::Nes.label_mask()[0],
+            255,
+            "the NES label runs off its top"
+        );
+        assert_eq!(Media::Snes.label_mask()[0], 0);
+    }
+
+    #[test]
+    fn nothing_sits_taller_in_the_slot_than_a_game_boy_pak() {
+        for m in Media::ALL {
+            let (w, h) = m.seated(240);
+            assert!(h <= SEATED_MAX_H && w <= 240, "{m:?} sits at {w}x{h}");
+        }
+    }
+}
