-    if mode == VideoMode::Actual || (w, h) == (SRC_W, SRC_H) {
-        return WHOLE_TEXTURE;
+    if (w, h) == (SRC_W, SRC_H) {
+        return PICTURE;
+    }
+    match mode {
+        VideoMode::Actual => PICTURE,
+        VideoMode::Stretch => {
+            let k = OUT_H as f32 / h as f32;
+            [SRC_W as f32 * k, SRC_H as f32 * k]
+        }
+    }
+}
+
+#[cfg(test)]
+mod fit_tests {
+    use super::*;
+
+    /// What reaches the panel is the picture inside the texture, so that is
+    /// what these check rather than the base size itself.
+    fn on_panel(platform: Platform, mode: VideoMode) -> (f32, f32) {
+        let [bw, bh] = base_size(platform, mode);
+        let (w, h) = platform.picture();
+        (bw * w as f32 / SRC_W as f32, bh * h as f32 / SRC_H as f32)
+    }
