+    /// One frame of `items` over a patterned game, as the panel shows it.
+    fn panel_after(via_canvas: bool, mount: Mount) -> (Vec<u8>, bool) {
+        let (pw, ph) = (out_w(), out_h());
+        let mut panel = vec![0u8; pw as usize * ph as usize * 4];
+        let target = fb::Target {
+            ptr: panel.as_mut_ptr(),
+            w: pw,
+            h: ph,
+            stride: pw as usize * 4,
+            bgr: true,
+        };
+        // SAFETY: `panel` outlives the frame drawn into it.
+        unsafe { fb::set_current_for_test(Some(target)) };
+        let mut c = Compositor::new(&NoSurface).expect("compositor");
+        c.mount = mount;
+        let mut frame = vec![0u8; (SRC_W * SRC_H * 4) as usize];
+        for (i, px) in frame.chunks_exact_mut(4).enumerate() {
+            let (x, y) = (i as u32 % SRC_W, i as u32 / SRC_W);
+            px.copy_from_slice(&[(x * 7) as u8, (y * 5) as u8, (x ^ y) as u8, 255]);
+        }
+        c.upload_game(&frame, (SRC_W, SRC_H));
+        let mut art = vec![0u8; 20 * 30 * 4];
+        for (i, px) in art.chunks_exact_mut(4).enumerate() {
+            px.copy_from_slice(&[255, (i * 3) as u8, 40, (i * 11) as u8]);
+        }
+        let tex = c.create_texture(20, 30, &art);
+        let mut items = vec![
+            Draw::Game,
+            Draw::Rect { x: 300.0, y: 40.5, w: 150.0, h: 36.0, colour: [0.1, 0.1, 0.1, 0.6] },
+            Draw::Tex { x: 310.0, y: 44.0, w: 40.0, h: 30.0, tex, alpha: 0.8 },
+        ];
+        if via_canvas {
+            let invisible = Draw::Rect { x: 0.0, y: 0.0, w: 1.0, h: 1.0, colour: [0.0; 4] };
+            items.insert(0, invisible);
+        }
+        c.begin_frame();
+        c.draw_list(&items);
+        let direct = c.direct_game;
+        c.end_frame((pw, ph));
+        // SAFETY: clearing the pointer before `panel` is dropped.
+        unsafe { fb::set_current_for_test(None) };
+        (panel, direct)
+    }
+
+    /// The overlay path has to put on the panel exactly what composing the
+    /// whole frame on the canvas did, mirrored or not. An invisible rect under
+    /// the game is what forces the canvas path for the reference.
+    #[test]
+    fn a_hud_over_the_game_lands_as_the_canvas_path_draws_it() {
+        for mount in [Mount::Normal, Mount::Half] {
+            let (a, took_fast) = panel_after(false, mount);
+            let (b, took_slow) = panel_after(true, mount);
+            assert!(took_fast && !took_slow, "the paths were not the ones under test");
+            let differ = a.chunks_exact(4).zip(b.chunks_exact(4)).filter(|(p, q)| p[..3] != q[..3]).count();
+            assert_eq!(differ, 0, "{differ} pixels differ from the canvas path");
+        }
+    }
