+        self.game.band = None;
+        let overlay = std::mem::take(&mut self.overlay);
+        self.draw_sprites(&overlay);
+        self.overlay = overlay;
+
+        let x_start = (x + bx0).max(0);
+        let x_end = (x + bx1).min(pw);
