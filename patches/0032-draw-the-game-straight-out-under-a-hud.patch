+fn is_sprite(d: &Draw) -> bool {
+    matches!(
+        d,
+        Draw::Rect { .. } | Draw::Tex { .. } | Draw::Part { .. } | Draw::Turned { .. }
+    )
+}
+
+/// The canvas rect a list of sprites can touch, as `[x0, y0, x1)` bounds, a
+/// pixel wider all round for rounding. A turned sprite is bounded by its
+/// diagonal, whichever way it faces.
+fn overlay_bounds(items: &[Draw], cw: i32, ch: i32) -> Option<(i32, i32, i32, i32)> {
+    let mut b: Option<(f32, f32, f32, f32)> = None;
+    for item in items {
+        let (x0, y0, x1, y1) = match *item {
+            Draw::Rect { x, y, w, h, .. } | Draw::Tex { x, y, w, h, .. } | Draw::Part { x, y, w, h, .. } => {
+                (x, y, x + w, y + h)
+            }
+            Draw::Turned { x, y, w, h, .. } => {
+                let (cx, cy, r) = (x + w / 2.0, y + h / 2.0, w.hypot(h) / 2.0);
+                (cx - r, cy - r, cx + r, cy + r)
+            }
+            Draw::Game | Draw::Shot { .. } => continue,
+        };
+        b = Some(match b {
+            None => (x0, y0, x1, y1),
+            Some((a, c, d, e)) => (a.min(x0), c.min(y0), d.max(x1), e.max(y1)),
+        });
+    }
+    let (x0, y0, x1, y1) = b?;
+    let x0 = (x0.floor() as i32 - 1).max(0);
+    let y0 = (y0.floor() as i32 - 1).max(0);
+    let x1 = (x1.ceil() as i32 + 1).min(cw);
+    let y1 = (y1.ceil() as i32 + 1).min(ch);
+    (x0 < x1 && y0 < y1).then_some((x0, y0, x1, y1))
+}
