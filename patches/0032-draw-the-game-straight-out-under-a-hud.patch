+    /// Compose the overlay over the rows it covers and copy just that rect to
+    /// the panel, which already holds the game from the direct pass. The canvas
+    /// gets what the panel shows there first -- the surround, then the game's
+    /// own rows -- so the sprites blend over the same pixels they would have on
+    /// the canvas path, without reading the panel back.
+    fn overlay_out(&mut self, target: fb::Target, (x, y): (i32, i32), half: bool) {
+        let (cw, ch) = (self.canvas.w as i32, self.canvas.h as i32);
+        let Some((bx0, by0, bx1, by1)) = overlay_bounds(&self.overlay, cw, ch) else {
+            return;
+        };
+        let (pw, ph) = (target.w as i32, target.h as i32);
+        let span = (bx1 - bx0) as usize * 4;
+        self.surround((target.w, target.h));
+        let surround = self.surround.take();
+        for cy in by0..by1 {
+            let at = (cy as usize * cw as usize + bx0 as usize) * 4;
+            let dst = &mut self.canvas.px[at..at + span];
+            let (sx, sy) = (x + bx0, y + cy);
+            match &surround {
+                Some(b) if sx >= 0 && sy >= 0 && sx + bx1 - bx0 <= b.w as i32 && sy < b.h as i32 => {
+                    let from = (sy as usize * b.w as usize + sx as usize) * 4;
+                    dst.copy_from_slice(&b.px[from..from + span]);
+                }
+                _ => dst.fill(0),
+            }
+        }
+        self.surround = surround;
