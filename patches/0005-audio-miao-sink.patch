diff --git a/crates/slot/src/audio/miao.rs b/crates/slot/src/audio/miao.rs
new file mode 100644
index 0000000..06c50d0
--- /dev/null
+++ b/crates/slot/src/audio/miao.rs
@@ -0,0 +1,212 @@
+//! Audio over SigmaStar's MI_AO, for devices whose ALSA will not play.
+//!
+//! The Miyoo Mini Flip's ALSA is a thin shim: it refuses the core's 32768 Hz,
+//! and at 48 kHz every write fails with `snd_pcm_recover` returning -512
+//! (ERESTARTSYS) persistently. The vendor's own stack goes through MI_AO.
+//!
+//! The vendor structs are reached through `libslotao.so`, a small C shim built
+//! against the Miyoo SDK headers (see `shim/slotao.c` in the port), rather than
+//! by describing `MI_AUDIO_Attr_t` in Rust where a wrong field offset would be
+//! silent memory corruption. It is `dlopen`ed exactly as libasound is, so the
+//! build needs no C toolchain and no vendor SDK.
+//!
+//! Unlike the ALSA sink this never releases the device on silence. Doing so is
+//! what produced a click every three seconds on this hardware, since each open
+//! and close pops the amplifier, and MI_AO is content to sit idle.
+
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc};
+use std::thread::JoinHandle;
+
+use libloading::{Library, Symbol};
+
+use super::ring::Ring;
+use super::sink::{AudioError, AudioSink};
+
+/// The rate the codec runs at. MI_AO's sample-rate enum has no 32768 entry, so
+/// the core's rate cannot be handed over directly; slot's own resampler in
+/// `emu.rs` converts to whatever the ring reports, which is set to this.
+const DEVICE_HZ: u32 = 48_000;
+const CHANNELS: u32 = 2;
+const PERIOD_FRAMES: usize = 512;
+/// Long enough that a late frame does not tear the stream, short enough that a
+/// wedged device does not hang the audio thread forever.
+const WRITE_TIMEOUT_MS: i32 = 200;
+
+const LIB_NAMES: [&str; 2] = ["libslotao.so", "/mnt/SDCARD/System/libslotao.so"];
+
+type Open = unsafe extern "C" fn(u32, u32, u32) -> i32;
+type Write = unsafe extern "C" fn(*const c_void, u32, u32, i32) -> i32;
+type Close = unsafe extern "C" fn();
+
+struct Shim {
+    open: Open,
+    write: Write,
+    close: Close,
+    _lib: Library,
+}
+
+impl Shim {
+    fn load() -> Result<Self, AudioError> {
+        let mut last = String::new();
+        for name in LIB_NAMES {
+            match unsafe { Library::new(name) } {
+                Ok(lib) => {
+                    macro_rules! sym {
+                        ($n:literal) => {{
+                            let s: Symbol<_> = unsafe { lib.get(concat!($n, "\0").as_bytes()) }
+                                .map_err(|e| AudioError::Device(format!("{}: {e}", $n)))?;
+                            unsafe { *s }
+                        }};
+                    }
+                    let open = sym!("slotao_open");
+                    let write = sym!("slotao_write");
+                    let close = sym!("slotao_close");
+                    return Ok(Shim {
+                        open,
+                        write,
+                        close,
+                        _lib: lib,
+                    });
+                }
+                Err(e) => last = format!("{name}: {e}"),
+            }
+        }
+        Err(AudioError::Device(last))
+    }
+}
+
+pub struct MiAoSink {
+    ring: Arc<Ring>,
+    device: Option<Device>,
+}
+
+struct Device {
+    stop: Arc<AtomicBool>,
+    join: JoinHandle<()>,
+}
+
+impl MiAoSink {
+    pub fn new() -> Self {
+        MiAoSink {
+            ring: Arc::new(Ring::new(0)),
+            device: None,
+        }
+    }
+
+    /// Whether the shim is present at all, so the caller can fall back to ALSA
+    /// without the cost of starting a thread that is only going to fail.
+    pub fn available() -> bool {
+        LIB_NAMES
+            .iter()
+            .any(|n| unsafe { Library::new(n) }.is_ok())
+    }
+
+    fn stop(&mut self) {
+        if let Some(d) = self.device.take() {
+            d.stop.store(true, Ordering::Relaxed);
+            let _ = d.join.join();
+        }
+    }
+}
+
+impl Default for MiAoSink {
+    fn default() -> Self {
+        MiAoSink::new()
+    }
+}
+
+impl Drop for MiAoSink {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+impl AudioSink for MiAoSink {
+    fn open(&mut self, _sample_rate: u32) -> Result<(), AudioError> {
+        self.stop();
+        let ring = self.ring.clone();
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        let (ready_tx, ready_rx) = mpsc::channel();
+
+        let join = std::thread::Builder::new()
+            .name("slot-audio-miao".into())
+            .spawn(move || {
+                // Ask the scheduler to favour this thread, as the input readers
+                // do. It spends its life blocked in MI_AO_SendFrame and needs
+                // almost no CPU, but on two cores against a renderer and an
+                // emulator it can still be left unscheduled -- and when it is,
+                // the ring runs dry and `fill` writes silence, which is what a
+                // stutter is. The input threads had exactly this problem.
+                //
+                // SAFETY: setpriority on the calling thread, 0 meaning "me".
+                unsafe {
+                    libc::setpriority(0, 0, -10);
+                }
+                let shim = match Shim::load() {
+                    Ok(s) => s,
+                    Err(e) => {
+                        let _ = ready_tx.send(Err(e));
+                        return;
+                    }
+                };
+                // SAFETY: the shim keeps its own "already open" state, and the
+                // only caller of these is this thread.
+                let err =
+                    unsafe { (shim.open)(DEVICE_HZ, CHANNELS, PERIOD_FRAMES as u32) };
+                if err != 0 {
+                    let _ = ready_tx.send(Err(AudioError::Config(format!(
+                        "MI_AO open: error {err}"
+                    ))));
+                    return;
+                }
+                // The ring, and so the resampler in emu.rs, follows the codec.
+                ring.reopen(DEVICE_HZ);
+                eprintln!("slot: audio MI_AO at {DEVICE_HZ} Hz");
+                let _ = ready_tx.send(Ok(()));
+
+                let mut buf = vec![0i16; PERIOD_FRAMES * CHANNELS as usize];
+                let mut complained = false;
+                while !flag.load(Ordering::Relaxed) {
+                    ring.fill(&mut buf);
+                    // SAFETY: buf holds PERIOD_FRAMES frames of CHANNELS i16s.
+                    let err = unsafe {
+                        (shim.write)(
+                            buf.as_ptr() as *const c_void,
+                            PERIOD_FRAMES as u32,
+                            CHANNELS,
+                            WRITE_TIMEOUT_MS,
+                        )
+                    };
+                    if err != 0 && !complained {
+                        complained = true;
+                        eprintln!("slot: audio: MI_AO send: error {err}");
+                    }
+                }
+                // SAFETY: closing what this thread opened.
+                unsafe { (shim.close)() };
+            })
+            .map_err(|e| AudioError::Device(e.to_string()))?;
+
+        match ready_rx.recv() {
+            Ok(Ok(())) => {
+                self.device = Some(Device { stop, join });
+                Ok(())
+            }
+            Ok(Err(e)) => {
+                let _ = join.join();
+                Err(e)
+            }
+            Err(_) => {
+                let _ = join.join();
+                Err(AudioError::NoDevice)
+            }
+        }
+    }
+
+    fn ring(&self) -> Arc<Ring> {
+        self.ring.clone()
+    }
+}
