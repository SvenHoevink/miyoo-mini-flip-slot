diff --git a/crates/slot/src/audio/miao.rs b/crates/slot/src/audio/miao.rs
new file mode 100644
index 0000000..875bfc9
--- /dev/null
+++ b/crates/slot/src/audio/miao.rs
@@ -0,0 +1,367 @@
+//! Audio over SigmaStar's MI_AO, for devices whose ALSA will not play.
+//!
+//! The Miyoo Mini Flip's ALSA is a thin shim: it refuses the core's 32768 Hz,
+//! and at 48 kHz every write fails with `snd_pcm_recover` returning -512
+//! (ERESTARTSYS) persistently. The vendor's own stack goes through MI_AO.
+//!
+//! The vendor structs are reached through `libslotao.so`, a small C shim built
+//! against the Miyoo SDK headers (see `shim/slotao.c` in the port), rather than
+//! by describing `MI_AUDIO_Attr_t` in Rust where a wrong field offset would be
+//! silent memory corruption. It is `dlopen`ed exactly as libasound is, so the
+//! build needs no C toolchain and no vendor SDK.
+//!
+//! Unlike the ALSA sink this never releases the device on silence. Doing so is
+//! what produced a click every three seconds on this hardware, since each open
+//! and close pops the amplifier, and MI_AO is content to sit idle.
+
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{mpsc, Arc};
+use std::thread::JoinHandle;
+
+use libloading::{Library, Symbol};
+
+use super::ring::Ring;
+use super::sink::{AudioError, AudioSink};
+
+/// The rate the codec runs at. MI_AO's sample-rate enum has no 32768 entry, so
+/// the core's rate cannot be handed over directly; slot's own resampler in
+/// `emu.rs` converts to whatever the ring reports, which is set to this.
+const DEVICE_HZ: u32 = 48_000;
+const CHANNELS: u32 = 2;
+/// Frames per MI_AO period, and so the granularity of everything downstream.
+///
+/// 512 frames is 10.7 ms at 48 kHz, and that was too coarse to throttle with.
+/// The sink tops the codec's queue up to a target and then sleeps, and the
+/// sleep cannot be shorter than this kernel's 10 ms tick -- so a cycle is about
+/// 11.9 ms against a 10.7 ms period, writes are whole periods, and it lost
+/// ground every cycle: measured at 84 periods a second against the codec's
+/// 93.75. The codec idled in the gaps, which is the chop, while production
+/// backed up and stalled the core on a full ring.
+///
+/// 128 frames is 2.7 ms, so a 10 ms wake-up covers about 3.75 of them and the
+/// rounding error is a quarter of a period rather than a whole one. It does not
+/// accumulate either, since each pass aims at a queue depth rather than a rate.
+/// The cost is four times as many SendFrame calls, ~375 a second.
+const PERIOD_FRAMES: usize = 128;
+/// Long enough that a late frame does not tear the stream, short enough that a
+/// wedged device does not hang the audio thread forever.
+const WRITE_TIMEOUT_MS: i32 = 200;
+
+const LIB_NAMES: [&str; 2] = ["libslotao.so", "/mnt/SDCARD/System/libslotao.so"];
+
+type Open = unsafe extern "C" fn(u32, u32, u32) -> i32;
+type Write = unsafe extern "C" fn(*const c_void, u32, u32, i32) -> i32;
+type Close = unsafe extern "C" fn();
+type Queued = unsafe extern "C" fn() -> i32;
+
+struct Shim {
+    open: Open,
+    write: Write,
+    close: Close,
+    queued: Queued,
+    _lib: Library,
+}
+
+impl Shim {
+    fn load() -> Result<Self, AudioError> {
+        let mut last = String::new();
+        for name in LIB_NAMES {
+            match unsafe { Library::new(name) } {
+                Ok(lib) => {
+                    macro_rules! sym {
+                        ($n:literal) => {{
+                            let s: Symbol<_> = unsafe { lib.get(concat!($n, "\0").as_bytes()) }
+                                .map_err(|e| AudioError::Device(format!("{}: {e}", $n)))?;
+                            unsafe { *s }
+                        }};
+                    }
+                    let open = sym!("slotao_open");
+                    let write = sym!("slotao_write");
+                    let close = sym!("slotao_close");
+                    let queued = sym!("slotao_queued");
+                    return Ok(Shim {
+                        open,
+                        write,
+                        close,
+                        queued,
+                        _lib: lib,
+                    });
+                }
+                Err(e) => last = format!("{name}: {e}"),
+            }
+        }
+        Err(AudioError::Device(last))
+    }
+}
+
+pub struct MiAoSink {
+    ring: Arc<Ring>,
+    device: Option<Device>,
+}
+
+struct Device {
+    stop: Arc<AtomicBool>,
+    join: JoinHandle<()>,
+}
+
+impl MiAoSink {
+    pub fn new() -> Self {
+        MiAoSink {
+            ring: Arc::new(Ring::new(0)),
+            device: None,
+        }
+    }
+
+    /// Whether the shim is present at all, so the caller can fall back to ALSA
+    /// without the cost of starting a thread that is only going to fail.
+    pub fn available() -> bool {
+        LIB_NAMES
+            .iter()
+            .any(|n| unsafe { Library::new(n) }.is_ok())
+    }
+
+    fn stop(&mut self) {
+        if let Some(d) = self.device.take() {
+            d.stop.store(true, Ordering::Relaxed);
+            let _ = d.join.join();
+        }
+    }
+}
+
+impl Default for MiAoSink {
+    fn default() -> Self {
+        MiAoSink::new()
+    }
+}
+
+impl Drop for MiAoSink {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+impl AudioSink for MiAoSink {
+    fn open(&mut self, _sample_rate: u32) -> Result<(), AudioError> {
+        self.stop();
+        let ring = self.ring.clone();
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        let (ready_tx, ready_rx) = mpsc::channel();
+
+        let join = std::thread::Builder::new()
+            .name("slot-audio-miao".into())
+            .spawn(move || {
+                // Ask the scheduler to favour this thread, as the input readers
+                // do. It spends its life blocked in MI_AO_SendFrame and needs
+                // almost no CPU, but on two cores against a renderer and an
+                // emulator it can still be left unscheduled -- and when it is,
+                // the ring runs dry and `fill` writes silence, which is what a
+                // stutter is. The input threads had exactly this problem.
+                //
+                // SAFETY: setpriority on the calling thread, 0 meaning "me".
+                unsafe {
+                    libc::setpriority(0, 0, -10);
+                }
+                let shim = match Shim::load() {
+                    Ok(s) => s,
+                    Err(e) => {
+                        let _ = ready_tx.send(Err(e));
+                        return;
+                    }
+                };
+                // SAFETY: the shim keeps its own "already open" state, and the
+                // only caller of these is this thread.
+                let err =
+                    unsafe { (shim.open)(DEVICE_HZ, CHANNELS, PERIOD_FRAMES as u32) };
+                if err != 0 {
+                    let _ = ready_tx.send(Err(AudioError::Config(format!(
+                        "MI_AO open: error {err}"
+                    ))));
+                    return;
+                }
+                // The ring, and so the resampler in emu.rs, follows the codec.
+                ring.reopen(DEVICE_HZ);
+                eprintln!("slot: audio MI_AO at {DEVICE_HZ} Hz");
+                let _ = ready_tx.send(Ok(()));
+
+                let mut buf = vec![0i16; PERIOD_FRAMES * CHANNELS as usize];
+
+                // The codec's queue is the latency, and it has to be held
+                // down rather than configured: `u32FrmNum` asked for two
+                // periods and this stack accepted 33 of them, 352 ms, which it
+                // then kept full because `Ring::fill` pads with silence instead
+                // of waiting. Every latency figure before this was measured on
+                // the ring alone and missed it.
+                //
+                // So write only while the codec is short, and let it drain to
+                // the target otherwise. `SLOTAO_QUEUE` tunes the depth in
+                // periods; three is ~32 ms at 512 frames and 48 kHz.
+                let mut complained = false;
+                let want = std::env::var("SLOTAO_QUEUE")
+                    .ok()
+                    .and_then(|v| v.trim().parse::<i32>().ok())
+                    .filter(|n| (0..=128).contains(n))
+                    // Off by default. Throttling the codec's queue is the only
+                    // way to control the 352 ms it otherwise holds, and it does
+                    // remove the lag -- but it also pins the drain at 43,008
+                    // frames a second against the 48,000 the codec is
+                    // configured for, identically at 512- and 128-frame
+                    // periods, which is unexplained. The ring then backs up,
+                    // push_blocking stalls the core, and the result is choppy.
+                    // Unthrottled is laggy and clean; that is the better
+                    // default until the 43,008 is understood.
+                    .unwrap_or(0);
+                // SAFETY: the shim is loaded and the channel is open.
+                let queued = || unsafe { (shim.queued)() };
+                eprintln!(
+                    "slot: audio: MI_AO queue target {want} periods (0 = unthrottled), {:.0} ms; it reports {} now",
+                    want as f64 * PERIOD_FRAMES as f64 * 1000.0 / DEVICE_HZ as f64,
+                    queued()
+                );
+
+                // What this loop actually does, since the ring's own trace
+                // says 0 starved and the chop is therefore downstream of it.
+                // The three things I cannot currently see: whether the codec's
+                // queue reaches 0 (a real hole in the output), how often a pass
+                // writes nothing, and whether SendFrame is failing -- only the
+                // first failure is ever reported.
+                let mut low = i32::MAX;
+                let mut empty = 0u32;
+                let mut errs = 0u32;
+                let mut wrote_total = 0u64;
+                let mut said = std::time::Instant::now();
+
+                while !flag.load(Ordering::Relaxed) {
+                    if said.elapsed() >= std::time::Duration::from_secs(5) {
+                        eprintln!(
+                            "slot: audio: codec queue low {low} of {want}, {empty} empty passes, {errs} send errors, {wrote_total} periods written"
+                        );
+                        (low, empty, errs, wrote_total) = (i32::MAX, 0, 0, 0);
+                        said = std::time::Instant::now();
+                    }
+                    // Hold the codec's queue near the target: without it the
+                    // sink races ahead and the 352 ms buffer stays full, which
+                    // is the sound running behind the picture.
+                    //
+                    // Top the queue *up* to the target rather than writing one
+                    // period per wake-up. The first attempt did the latter and
+                    // sounded far worse than the lag it fixed: a period is
+                    // 10.7 ms of audio and CONFIG_HZ here is 100, so a "2 ms"
+                    // sleep is a 10 ms one, and one period per 10 ms is the
+                    // codec's own drain rate with no slack at all -- every
+                    // hiccup became an underrun. Topping up decouples
+                    // throughput from the timer: each pass writes however many
+                    // periods actually drained, so a late wake-up is made good
+                    // by a longer write rather than lost.
+                    //
+                    // A negative answer means the channel will not say, and
+                    // then the old unthrottled behaviour is the safe one: lag
+                    // beats silence.
+                    let q = if want > 0 { queued() } else { -1 };
+                    if q >= 0 {
+                        low = low.min(q);
+                        if q >= want {
+                            std::thread::sleep(std::time::Duration::from_millis(2));
+                            continue;
+                        }
+
+                        // Everything that drained, in one pass -- but only
+                        // as far as the ring can actually supply.
+                        //
+                        // `Ring::fill` pads with silence rather than waiting,
+                        // so writing a period the ring cannot fill puts a hole
+                        // in the stream. A top-up of up to `want` periods is
+                        // 2560 frames against a ring target of 1600, so the
+                        // burst outran the ring and the padding was audible as
+                        // crackle. The codec is already holding ~53 ms; that
+                        // cushion is there to cover a short ring, and it only
+                        // works if we let it drain instead of filling it with
+                        // zeros.
+                        let mut wrote = 0;
+                        for _ in 0..(want - q).min(want) {
+                            if ring.queued_frames() < PERIOD_FRAMES {
+                                break;
+                            }
+                            wrote += 1;
+                            ring.fill(&mut buf);
+                            // SAFETY: buf holds PERIOD_FRAMES frames.
+                            let err = unsafe {
+                                (shim.write)(
+                                    buf.as_ptr() as *const c_void,
+                                    PERIOD_FRAMES as u32,
+                                    CHANNELS,
+                                    WRITE_TIMEOUT_MS,
+                                )
+                            };
+                            if err != 0 {
+                                errs += 1;
+                                if !complained {
+                                    complained = true;
+                                    eprintln!("slot: audio: MI_AO send: error {err}");
+                                }
+                            }
+                        }
+                        wrote_total += wrote as u64;
+                        if wrote == 0 {
+                            empty += 1;
+                        }
+                        // Sleep every pass, not just the empty ones. Polling
+                        // QueryChnStat and writing with no pause runs this
+                        // thread hot, and at priority -10 against the emulator
+                        // at -8 it takes the CPU the core needs: measured at 51
+                        // core frames a second instead of 60, which is a 10%
+                        // audio shortfall, which is the codec reaching 0 and
+                        // the chop. The audio thread starving the core it
+                        // depends on.
+                        //
+                        // Safe here only because the pass tops the queue up to
+                        // the target: one wake-up every 10 ms -- the floor on
+                        // this kernel -- can deliver 5 periods, 53 ms, where the
+                        // codec drains 10.7 ms in that time. The first attempt
+                        // at this wrote a single period per wake-up, which was
+                        // exactly the drain rate with no slack, and that is why
+                        // sleeping sounded worse then and is right now.
+                        std::thread::sleep(std::time::Duration::from_millis(2));
+                        continue;
+                    }
+                    ring.fill(&mut buf);
+                    // SAFETY: buf holds PERIOD_FRAMES frames of CHANNELS i16s.
+                    let err = unsafe {
+                        (shim.write)(
+                            buf.as_ptr() as *const c_void,
+                            PERIOD_FRAMES as u32,
+                            CHANNELS,
+                            WRITE_TIMEOUT_MS,
+                        )
+                    };
+                    if err != 0 && !complained {
+                        complained = true;
+                        eprintln!("slot: audio: MI_AO send: error {err}");
+                    }
+                }
+                // SAFETY: closing what this thread opened.
+                unsafe { (shim.close)() };
+            })
+            .map_err(|e| AudioError::Device(e.to_string()))?;
+
+        match ready_rx.recv() {
+            Ok(Ok(())) => {
+                self.device = Some(Device { stop, join });
+                Ok(())
+            }
+            Ok(Err(e)) => {
+                let _ = join.join();
+                Err(e)
+            }
+            Err(_) => {
+                let _ = join.join();
+                Err(AudioError::NoDevice)
+            }
+        }
+    }
+
+    fn ring(&self) -> Arc<Ring> {
+        self.ring.clone()
+    }
+}
