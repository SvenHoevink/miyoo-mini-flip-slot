+#[cfg(test)]
+mod crt_tests {
+    use super::{Game, Image};
+    use crate::lcd3x::{crt_column, crt_row, ScreenEffect, CRT_GAIN, CRT_GAP_DEPTH};
+    use crate::surface::{out_h, out_w};
+    use crate::WHOLE_TEXTURE;
+
+    const W: u32 = 256;
+    const H: u32 = 224;
+
+    /// A NES/SNES frame, every texel a different colour, at `base` on the canvas.
+    fn console(base: [f32; 2]) -> Game {
+        let mut g = Game::new();
+        let mut frame = Vec::with_capacity((W * H * 4) as usize);
+        for y in 0..H {
+            for x in 0..W {
+                frame.extend([
+                    (x % 251) as u8,
+                    (y % 211) as u8,
+                    ((x + 2 * y) % 199) as u8,
+                    0,
+                ]);
+            }
+        }
+        g.upload(&frame, (W, H));
+        g.src = WHOLE_TEXTURE;
+        g.pic = WHOLE_TEXTURE;
+        g.base = base;
+        g.effect = ScreenEffect::Crt;
+        g
+    }
+
+    /// The tables against `crt_row` and `crt_column` evaluated per pixel, at the
+    /// actual 2x and at the stretch that fills the panel's height.
+    fn matches_the_mask_in_floats(base: [f32; 2]) {
+        let mut g = console(base);
+        let mut canvas = Image::new(out_w(), out_h());
+        assert_eq!(g.draw(&mut canvas, None), 2);
+        let (rx, ry, rw, rh) = g.rect();
+        let (x0, y0) = (rx.round() as i32, ry.round() as i32);
+        let (x1, y1) = ((rx + rw).round() as i32, (ry + rh).round() as i32);
+        let mut worst = 0i32;
+        for py in y0..y1 {
+            let at = |y: f32| (y - ry) / rh * H as f32;
+            let yk = crt_row(at(py as f32), at(py as f32 + 1.0));
+            let sy = ((at(py as f32 + 0.5)) as u32).min(H - 1);
+            for px in x0..x1 {
+                let sx = (((px as f32 + 0.5 - rx) / rw * W as f32) as u32).min(W - 1);
+                let xk = crt_column(px);
+                for c in 0..3usize {
+                    let s = g.frame.px[((sy * W + sx) * 4) as usize + c] as f32;
+                    let want = (s * xk[2 - c] * yk).clamp(0.0, 255.0) as i32;
+                    let got =
+                        canvas.px[((py as u32 * out_w() + px as u32) * 4) as usize + c] as i32;
+                    worst = worst.max((got - want).abs());
+                }
+            }
+        }
+        assert!(worst <= 2, "the tables differ from the mask by {worst}");
+    }
+
+    #[test]
+    fn the_tables_match_the_mask_at_2x() {
+        matches_the_mask_in_floats([512.0, 448.0]);
+    }
+
+    #[test]
+    fn the_tables_match_the_mask_stretched() {
+        matches_the_mask_in_floats([640.0, 560.0]);
+    }
+
+    /// At 2x the gap is exactly the second panel row of every source row.
+    #[test]
+    fn at_2x_every_other_row_is_the_gap() {
+        for sy in 0..H {
+            let y = sy as f32;
+            assert_eq!(crt_row(y, y + 0.5), CRT_GAIN);
+            assert_eq!(crt_row(y + 0.5, y + 1.0), CRT_GAIN * (1.0 - CRT_GAP_DEPTH));
+        }
+    }
+
+    /// At 2.5x the rows fall 2, 3, 2, 3 per source row; averaging over each row
+    /// rather than sampling its centre is what keeps a dark line in every one.
+    #[test]
+    fn stretched_every_source_row_keeps_a_dark_line() {
+        let step = 1.0 / 2.5;
+        let mut darkest = vec![f32::MAX; H as usize];
+        for py in 0..(H as f32 * 2.5) as u32 {
+            let y = py as f32 * step;
+            let k = crt_row(y, y + step);
+            let sy = ((y + step / 2.0) as usize).min(H as usize - 1);
+            darkest[sy] = darkest[sy].min(k);
+        }
+        let lit = CRT_GAIN * (1.0 - CRT_GAP_DEPTH / 2.0);
+        assert!(darkest.iter().all(|&k| k < lit), "{darkest:?}");
+    }
+
+    /// The grille never asks for more than 1.0 per column, so s * k stays a u16.
+    #[test]
+    fn the_grille_fits_the_column_table() {
+        for x in -3..6 {
+            assert!(crt_column(x).iter().all(|&k| k <= 1.0));
+            assert_eq!(crt_column(x).iter().filter(|&&k| k == 1.0).count(), 1);
+        }
+    }
+}
