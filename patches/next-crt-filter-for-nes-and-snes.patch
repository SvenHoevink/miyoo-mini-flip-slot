+    let s = slot_store::read_slot_state(d.path());
+    assert_eq!((s.shader_nes, s.shader_snes), (Shader::Off, Shader::Crt));
+    press(&mut a, Btn::Right);
+    assert_eq!(a.screen_shader(), Shader::Crt);
