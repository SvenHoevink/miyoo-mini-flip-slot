+// The CRT, for the NES and SNES: a dark band across the lower half of each
+// source row, which is the gap between scanlines, and an aperture grille of
+// one panel column per phosphor. Both halves are separable -- the gap depends
+// on the row only, the grille on the column only -- which is what lets the
+// software backend fold them into its row and column tables, so the effect
+// costs nothing per pixel there. The gain pays back most of what the two
+// take, and saturates on white rather than dimming it.
+pub const CRT_GAP: f32 = 0.5;
+pub const CRT_GAP_DEPTH: f32 = 0.4;
+pub const CRT_MASK_DIM: f32 = 0.85;
+pub const CRT_GAIN: f32 = 1.2;
+
+/// How much of source rows `0..y` lies in a scanline gap.
+fn crt_gap_area(y: f32) -> f32 {
+    y.floor() * (1.0 - CRT_GAP) + (y.fract() - CRT_GAP).max(0.0)
+}
+
+/// The row factor for a panel row covering source rows `y0..y1`. Averaged over
+/// the row rather than sampled, so that a non-integer scale -- 2.5x when the
+/// picture is stretched to the panel's height -- still gives every source
+/// row one dark line instead of a beat of two and none.
+pub fn crt_row(y0: f32, y1: f32) -> f32 {
+    let cover = if y1 > y0 {
+        (crt_gap_area(y1) - crt_gap_area(y0)) / (y1 - y0)
+    } else {
+        (y0.fract() >= CRT_GAP) as u8 as f32
+    };
+    CRT_GAIN * (1.0 - CRT_GAP_DEPTH * cover)
+}
+
+/// The column factors, RGB, for panel column `x`.
+pub fn crt_column(x: i32) -> [f32; 3] {
+    let mut k = [CRT_MASK_DIM; 3];
+    k[x.rem_euclid(3) as usize] = 1.0;
+    k
+}
