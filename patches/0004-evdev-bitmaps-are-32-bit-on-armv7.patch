 pub fn has_bit(mask: &str, bit: u16) -> bool {
+    // The kernel prints these bitmaps as `unsigned long`, most significant word
+    // first, so the word size is its BITS_PER_LONG: 32 on armv7 (the Miyoo Mini
+    // Flip), 64 on aarch64. Assuming 64 everywhere reads every bit above 31 out
+    // of the wrong word on a 32-bit device, which silently loses most of the
+    // keyboard range. usize::BITS matches BITS_PER_LONG for the process doing
+    // the reading, which is the one that matters.
+    has_bit_in_words(mask, bit, usize::BITS as usize)
+}
+
+/// The word size is a parameter so the 32-bit maths can be tested from a 64-bit
+/// host, where `usize::BITS` would otherwise hide the case being fixed.
+fn has_bit_in_words(mask: &str, bit: u16, word_bits: usize) -> bool {
     let words: Vec<&str> = mask.split_whitespace().collect();
-    let from_end = usize::from(bit) / 64;
+    let from_end = usize::from(bit) / word_bits;
     let Some(word) = words.len().checked_sub(from_end + 1).map(|i| words[i]) else {
         return false;
     };
-    u64::from_str_radix(word, 16).is_ok_and(|w| w >> (bit % 64) & 1 == 1)
+    u64::from_str_radix(word, 16).is_ok_and(|w| w >> (usize::from(bit) % word_bits) & 1 == 1)
 }
 
 pub fn rumble_node(sysfs: &Path) -> Option<String> {
@@ -537,3 +549,45 @@ pub fn read_only_in(mounts: &str, path: &Path) -> bool {
         .max_by_key(|(point, _)| point.as_os_str().len())
         .is_some_and(|(_, options)| options.split(',').any(|o| o == "ro"))
 }
+
+#[cfg(test)]
+mod miyoo_bitmap_tests {
+    use super::has_bit_in_words;
+
+    /// The Mini Flip's `soc:gpio_keys` capability bitmap, as the device prints
+    /// it. Four words for a 32-bit kernel; read as 64-bit it is nonsense.
+    const GPIO_KEYS: &str = "1c1682 0 3000400 3014c002";
+
+    fn has(bit: u16) -> bool {
+        has_bit_in_words(GPIO_KEYS, bit, 32)
+    }
+
+    #[test]
+    fn finds_every_button_the_device_advertises() {
+        // The 18 keys the probe decoded, cross-checked against Allium's map.
+        for bit in [
+            1, 14, 15, 18, 20, 28, 29, 42, 56, 57, 97, 103, 105, 106, 108, 114, 115, 116,
+        ] {
+            assert!(has(bit), "missed bit {bit}");
+        }
+    }
+
+    #[test]
+    fn does_not_invent_buttons() {
+        // Gamepad codes: this device has none of them.
+        for bit in [0x130, 0x131, 0x133, 0x13a] {
+            assert!(!has(bit), "invented bit {bit:#x}");
+        }
+        // Neighbours of real bits, to catch an off-by-one in the word maths.
+        for bit in [2, 13, 16, 58, 102, 117] {
+            assert!(!has(bit), "invented bit {bit}");
+        }
+    }
+
+    #[test]
+    fn reading_a_32_bit_mask_as_64_loses_the_keyboard_range() {
+        // The bug this replaced: KEY_SPACE is the A button on every Miyoo.
+        assert!(has(57));
+        assert!(!has_bit_in_words(GPIO_KEYS, 57, 64));
+    }
+}
