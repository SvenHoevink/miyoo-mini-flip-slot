+/// The profile's skip, copy and blend counts for a row, which the row blend
+/// no longer counts as it goes.
+fn count_texels(line: &[u8], enough: u8) -> [u32; 3] {
+    let mut n = [0u32; 3];
+    for p in line.chunks_exact(4) {
+        n[match p[3] {
+            0 => 0,
+            a if a >= enough => 1,
+            _ => 2,
+        }] += 1;
     }
+    n
 }
 
