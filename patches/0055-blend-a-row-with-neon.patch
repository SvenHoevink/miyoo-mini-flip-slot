+/// `blend` across a row: each `src` pixel over the `dst` one under it, with
+/// a pixel of alpha `enough` or more copied whole and one of alpha 0 left
+/// alone, as the blit's loops did a pixel at a time. Cart faces fading in and
+/// out ran every pixel through `blend` -- 2-4 ms a face, several a frame,
+/// against 0.9 when the face sits still and is copied -- so the bulk is a
+/// NEON loop, eight pixels at a time. `blend_row_tests` drives it against
+/// `blend_row_scalar` under qemu, byte for byte.
+#[cfg(target_arch = "arm")]
+fn blend_row(dst: &mut [u8], src: &[u8], enough: u8) {
+    let n = dst.len().min(src.len()) / 4;
+    let chunks = n / 8;
+    if chunks > 0 {
+        // SAFETY: `chunks` counts whole groups of eight pixels inside both
+        // slices, and the loop runs exactly that many times. Every product
+        // and sum fits sixteen bits: 255 * 255 + 255 * 0 + 128 at most.
+        unsafe {
+            core::arch::asm!(
+                ".fpu neon",
+                "vmov.i16 q14, #128",
+                "vdup.8 d31, {e}",
+                "2:",
+                // Channels apart: d0-d3 the source's, d4-d7 the panel's.
+                "vld4.8 {{d0, d1, d2, d3}}, [{s}]!",
+                "vld4.8 {{d4, d5, d6, d7}}, [{d}]",
+                "vmvn d30, d3",
+                // c * a + under * (255 - a), each colour, and under's alpha
+                // times (255 - a) for the alpha.
+                "vmull.u8 q10, d0, d3",
+                "vmlal.u8 q10, d4, d30",
+                "vmull.u8 q11, d1, d3",
+                "vmlal.u8 q11, d5, d30",
+                "vmull.u8 q12, d2, d3",
+                "vmlal.u8 q12, d6, d30",
+                "vmull.u8 q13, d7, d30",
+                // div255, rounded: x += 128; (x + (x >> 8)) >> 8.
+                "vadd.i16 q10, q10, q14",
+                "vadd.i16 q11, q11, q14",
+                "vadd.i16 q12, q12, q14",
+                "vadd.i16 q13, q13, q14",
+                "vsra.u16 q10, q10, #8",
+                "vsra.u16 q11, q11, #8",
+                "vsra.u16 q12, q12, #8",
+                "vsra.u16 q13, q13, #8",
+                "vshrn.u16 d16, q10, #8",
+                "vshrn.u16 d17, q11, #8",
+                "vshrn.u16 d18, q12, #8",
+                "vshrn.u16 d19, q13, #8",
+                // Alpha: a + that, saturating at 255, as `blend`'s min.
+                "vqadd.u8 d19, d3, d19",
+                // Opaque enough: the source whole. Alpha 0 needs nothing: the
+                // sums above give back the panel's bytes exactly then, as
+                // div255(v * 255) is v.
+                "vcge.u8 d20, d3, d31",
+                "vbit d16, d0, d20",
+                "vbit d17, d1, d20",
+                "vbit d18, d2, d20",
+                "vbit d19, d3, d20",
+                "vst4.8 {{d16, d17, d18, d19}}, [{d}]!",
+                "subs {n}, {n}, #1",
+                "bne 2b",
+                e = in(reg) enough as u32,
+                s = inout(reg) src.as_ptr() => _,
+                d = inout(reg) dst.as_mut_ptr() => _,
+                n = inout(reg) chunks => _,
+                out("q0") _,
+                out("q1") _,
+                out("q2") _,
+                out("q3") _,
+                out("q8") _,
+                out("q9") _,
+                out("q10") _,
+                out("q11") _,
+                out("q12") _,
+                out("q13") _,
+                out("q14") _,
+                out("q15") _,
+                options(nostack),
+            );
+        }
+    }
+    let done = chunks * 8 * 4;
+    blend_row_scalar(&mut dst[done..n * 4], &src[done..n * 4], enough);
+}
+
+#[cfg(not(target_arch = "arm"))]
+fn blend_row(dst: &mut [u8], src: &[u8], enough: u8) {
+    blend_row_scalar(dst, src, enough)
+}
+
+/// The rule `blend_row` is tested against, its tail, and the fallback off
+/// the device: what the blit's per-pixel loops did.
+fn blend_row_scalar(dst: &mut [u8], src: &[u8], enough: u8) {
+    for (d, s) in dst.chunks_exact_mut(4).zip(src.chunks_exact(4)) {
+        if s[3] == 0 {
+            continue;
+        }
+        if s[3] >= enough {
+            d.copy_from_slice(s);
+            continue;
+        }
+        blend(d, [s[0], s[1], s[2], s[3]]);
+    }
 }
 
