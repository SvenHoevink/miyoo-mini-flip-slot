+#[cfg(test)]
+mod blend_row_tests {
+    use super::{blend_row, blend_row_scalar, OPAQUE_ENOUGH};
+
+    /// Every source alpha against a spread of source and panel colours and
+    /// panel alphas, at both thresholds the blit uses, in rows whose length
+    /// is not a whole number of NEON groups: the row blend has to be the
+    /// per-pixel rule, byte for byte.
+    #[test]
+    fn the_row_blend_is_the_per_pixel_rule_byte_for_byte() {
+        let levels: Vec<u8> = (0..=255u32)
+            .step_by(17)
+            .map(|v| v as u8)
+            .chain([1, 254])
+            .collect();
+        let mut src = Vec::new();
+        let mut under = Vec::new();
+        for a in 0..=255u8 {
+            for (i, &c) in levels.iter().enumerate() {
+                let d = levels[(i * 7 + a as usize) % levels.len()];
+                src.extend_from_slice(&[c, 255 - c, c / 2, a]);
+                under.extend_from_slice(&[
+                    d,
+                    d / 3,
+                    255 - d,
+                    levels[(i + a as usize) % levels.len()],
+                ]);
+            }
+        }
+        for enough in [OPAQUE_ENOUGH, 255] {
+            for pixels in [src.len() / 4, 8, 13, 1, 31] {
+                let n = pixels * 4;
+                let mut a = under[..n].to_vec();
+                let mut b = under[..n].to_vec();
+                blend_row(&mut a, &src[..n], enough);
+                blend_row_scalar(&mut b, &src[..n], enough);
+                if let Some(i) = a.iter().zip(&b).position(|(x, y)| x != y) {
+                    let px = i / 4 * 4;
+                    panic!(
+                        "byte {i}, enough {enough}: src {:?} under {:?} -> neon {:?} scalar {:?}",
+                        &src[px..px + 4],
+                        &under[px..px + 4],
+                        &a[px..px + 4],
+                        &b[px..px + 4]
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn the_row_blend_writes_nothing_past_its_row() {
+        let src = vec![100u8; 64 * 4];
+        let mut out = vec![7u8; 72 * 4];
+        blend_row(&mut out[..40 * 4], &src[..40 * 4], 255);
+        assert!(
+            out[40 * 4..].iter().all(|&v| v == 7),
+            "wrote past 40 pixels"
+        );
+    }
+}
