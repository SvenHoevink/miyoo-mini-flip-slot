+
+#[test]
+fn a_driven_worker_makes_up_a_present_the_display_missed() {
+    let (emu, log) = spawn_probe(Duration::ZERO);
+    emu.set_speed(Speed::Normal);
+    emu.set_driven(true);
+    assert!(
+        wait_for(|| emu.locked()),
+        "the worker never locked to the display"
+    );
+    emu.tick(PANEL);
+    emu.wait_frame(Duration::from_millis(100));
+    std::thread::sleep(Duration::from_millis(5));
+    log.lock().expect("the skip log").clear();
+    for _ in 0..20 {
+        emu.tick(PANEL);
+        emu.tick(PANEL);
+        emu.wait_frame(Duration::from_millis(100));
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let ran = log.lock().expect("the skip log").len();
+    assert!(
+        ran >= 39,
+        "{ran} frames for 40 ticks: a present that spanned two blanks slowed the game"
+    );
 }
 
