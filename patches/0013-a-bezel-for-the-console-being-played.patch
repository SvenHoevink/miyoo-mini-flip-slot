+    fn a_cropped_game_draws_the_picture_alone() {
+        let (x, y, w, h) = gb().rect();
+        // Within a float's worth of 480x432: the crop is a ratio of the
+        // texture, not a count of pixels.
+        assert!(
+            (w - 480.0).abs() < 0.01 && (h - 432.0).abs() < 0.01,
+            "{w}x{h}"
+        );
+        assert!(
+            (x - (OUT_W as f32 - w) / 2.0).abs() < 0.01
+                && (y - (OUT_H as f32 - h) / 2.0).abs() < 0.01,
+            "at {x},{y}"
+        );
+    }
+
