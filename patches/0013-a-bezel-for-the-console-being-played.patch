+/// How many rows (or columns) at the edge are as flat as the outermost one.
+///
+/// Each line is compared with the one before it, not with the outermost one.
+/// The plastic is subtly lit across the art -- the columns brighten by 1.6%
+/// from the left edge inwards -- so measuring against line 0 measures that
+/// gradient and stops the band in the middle of flat plastic. A gradient
+/// steps gently and an edge jumps: 1% of the plastic's own brightness tells
+/// them apart, and the spread test catches a change of texture the brightness
+/// alone would miss.
+///
+/// Both halves were found by rendering it: a looser rule took the frame's
+/// highlight row (3.9% brighter than plastic) and mirrored it across the
+/// margin as a visible line at y=24, and a mean-against-line-0 rule left the
+/// Game Boy Color's sides too thin to fill their own margin.
+fn plain_band(art: &[u8], aw: usize, ah: usize, axis: Axis) -> usize {
+    let len = match axis {
+        Axis::Row => ah,
+        Axis::Column => aw,
+    };
+    let stat = |i: usize| -> (f32, f32) {
+        let n = match axis {
+            Axis::Row => aw,
+            Axis::Column => ah,
+        };
+        let at = |k: usize| match axis {
+            Axis::Row => (i * aw + k) * 4,
+            Axis::Column => (k * aw + i) * 4,
+        };
