+    use super::*;
+
+    /// A stand-in bezel: plain "plastic" at the edges, a loud band inside it
+    /// where the screen frame would be, so the band finder has something to
+    /// stop at.
+    fn art() -> Vec<u8> {
+        let (w, h) = (BEZEL_ART.0 as usize, BEZEL_ART.1 as usize);
+        let mut px = vec![0u8; w * h * 4];
+        for y in 0..h {
+            for x in 0..w {
+                let frame = y >= 14 && y < h - 14 && x >= 14 && x < w - 14;
+                let v = match frame {
+                    // Loud and varying, like the frame and the picture hole.
+                    true => ((x * 7 + y * 13) % 256) as u8,
+                    // Plastic: flat, with a pixel of noise.
+                    false => 108 + ((x + y) % 3) as u8,
+                };
+                let p = (y * w + x) * 4;
+                px[p..p + 4].copy_from_slice(&[v, v, v, 255]);
+            }
+        }
+        px
+    }
+
+    fn at(px: &[u8], w: usize, x: usize, y: usize) -> [u8; 4] {
+        let p = (y * w + x) * 4;
+        [px[p], px[p + 1], px[p + 2], px[p + 3]]
+    }
+
+    #[test]
+    fn the_art_is_placed_untouched_and_the_panel_is_filled() {
+        let src = art();
+        let out = fill_panel(&src);
+        let (aw, ah) = (BEZEL_ART.0 as usize, BEZEL_ART.1 as usize);
+        let (pw, ph) = (OUT_W as usize, OUT_H as usize);
+        assert_eq!(out.len(), pw * ph * 4);
+
+        let (ox, oy) = ((pw - aw) / 2, (ph - ah) / 2);
+        for (x, y) in [(0, 0), (aw / 2, ah / 2), (aw - 1, ah - 1), (121, 27)] {
+            assert_eq!(
+                at(&out, pw, x + ox, y + oy),
+                at(&src, aw, x, y),
+                "the art moved or was resampled at {x},{y}"
+            );
+        }
+        assert!(
+            out.chunks_exact(4).all(|p| p[3] == 255),
+            "the filled margin left transparent pixels"
+        );
+    }
+
+    /// The margin has to come from the plastic at the edge, not from the
+    /// frame a few rows in: reflecting the whole pad depth would drag the
+    /// screen's own border out into the bezel.
+    #[test]
+    fn the_margin_is_plastic_rather_than_the_frame() {
+        let src = art();
+        let out = fill_panel(&src);
+        let (pw, ph) = (OUT_W as usize, OUT_H as usize);
+        for (x, y) in [
+            (pw / 2, 0),
+            (pw / 2, 5),
+            (pw / 2, ph - 1),
+            (0, ph / 2),
+            (pw - 1, ph / 2),
+        ] {
+            let v = at(&out, pw, x, y)[0];
+            assert!(
+                (107..=111).contains(&v),
+                "margin pixel at {x},{y} is {v}, which is not the plastic"
+            );
+        }
+    }
+
+    /// Against the art that actually ships, and testing the thing that went
+    /// wrong rather than the mechanism that went wrong.
+    ///
+    /// The first version of the band finder took the frame's highlight row --
+    /// 3.9% brighter than the plastic -- and mirrored it across the margin as
+    /// a line, which only showed up by rendering a frame and reading the row
+    /// means out of it. So: fill both real bezels and insist every line of the
+    /// margin sits within 3% of the plastic it is supposed to be made of. The
+    /// two bezels stop their bands in different places (13 rows and 9), which
+    /// is why this asks about the result and not the number.
+    #[test]
+    fn the_real_bezels_fill_with_plastic_and_no_seam() {
+        let (aw, ah) = (BEZEL_ART.0 as usize, BEZEL_ART.1 as usize);
+        let (pw, ph) = (OUT_W as usize, OUT_H as usize);
+        let (ox, oy) = ((pw - aw) / 2, (ph - ah) / 2);
+        let lum = |px: &[u8], w: usize, x: usize, y: usize| {
+            let p = (y * w + x) * 4;
+            (px[p] as f32 + px[p + 1] as f32 + px[p + 2] as f32) / 3.0
+        };
+        for (name, png) in [("gb", BEZEL_GB_PNG), ("gbc", BEZEL_GBC_PNG)] {
+            let art = art::cover_bytes(png, BEZEL_ART.0, BEZEL_ART.1).expect("decode");
+            let out = fill_panel(&art);
+            // The plastic, measured where the art says it is.
+            let want = (0..aw).map(|x| lum(&art, aw, x, 0)).sum::<f32>() / aw as f32;
+            let row_mean = |y: usize| (0..pw).map(|x| lum(&out, pw, x, y)).sum::<f32>() / pw as f32;
+            for y in (0..oy).chain(ph - oy..ph) {
+                let got = row_mean(y);
+                assert!(
+                    (got - want).abs() < want * 0.03,
+                    "{name}: margin row {y} is {got:.1} against plastic at {want:.1}"
+                );
+            }
+            // And the sides, over the art's own rows.
+            for x in (0..ox).chain(pw - ox..pw) {
+                let got = (oy..ph - oy).map(|y| lum(&out, pw, x, y)).sum::<f32>() / (ah) as f32;
+                assert!(
+                    (got - want).abs() < want * 0.06,
+                    "{name}: margin column {x} is {got:.1} against plastic at {want:.1}"
+                );
+            }
+        }
+    }
