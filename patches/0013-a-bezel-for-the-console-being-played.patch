+/// Grow a bezel from the picture's frame to the whole panel, by extending the
+/// plastic rather than stretching the art.
+///
+/// The art is 720x480, the picture's frame, and the panel is 752x560 -- 16px
+/// of bare panel down each side and 40 top and bottom, which read as a black
+/// border around the console body. Scaling the art to the panel would blur a
+/// texture, distort the lamps and lettering, and move the hole off the picture
+/// it has to frame. Nothing about the art is touched here: it is placed at
+/// (16, 40), where its hole still lands exactly on the picture, and the margin
+/// is filled with more of the plastic that is already at each edge.
+///
+/// The band to take that plastic from is found rather than assumed, because
+/// the frame starts 14 rows in on these two and a user's own bezel will differ:
+/// rows are taken from the edge while they stay as flat as the outermost one,
+/// and the margin is filled by reflecting that band back and forth. A mirror
+/// rather than a repeat, so the seams fall on matching pixels.
+fn fill_panel(art: &[u8]) -> Vec<u8> {
+    let (aw, ah) = (BEZEL_ART.0 as usize, BEZEL_ART.1 as usize);
+    let (pw, ph) = (OUT_W as usize, OUT_H as usize);
+    if art.len() < aw * ah * 4 || pw < aw || ph < ah {
+        return art.to_vec();
+    }
+    let (ox, oy) = ((pw - aw) / 2, (ph - ah) / 2);
+    let mut out = vec![0u8; pw * ph * 4];
+
+    // The art, untouched, in the middle.
+    for y in 0..ah {
+        let from = y * aw * 4;
+        let to = ((y + oy) * pw + ox) * 4;
+        out[to..to + aw * 4].copy_from_slice(&art[from..from + aw * 4]);
+    }
+
+    // Sideways first, over the art's own rows, then down and up over the
+    // whole width -- so the corners come from plastic that is already there.
+    let band_x = plain_band(art, aw, ah, Axis::Column).min(ox.max(1));
+    for y in 0..ah {
+        let row = (y + oy) * pw * 4;
+        for x in 0..ox {
+            let src = ox + mirror(ox - 1 - x, band_x);
+            let (d, s) = ((row + x * 4), (row + src * 4));
+            out.copy_within(s..s + 4, d);
+            let (d, s) = (
+                (row + (pw - 1 - x) * 4),
+                (row + (pw - 1 - ox - mirror(ox - 1 - x, band_x)) * 4),
+            );
+            out.copy_within(s..s + 4, d);
+        }
+    }
+    let band_y = plain_band(art, aw, ah, Axis::Row).min(oy.max(1));
+    for y in 0..oy {
+        let top_src = (oy + mirror(oy - 1 - y, band_y)) * pw * 4;
+        let top_dst = y * pw * 4;
+        out.copy_within(top_src..top_src + pw * 4, top_dst);
+        let bot_src = (ph - 1 - oy - mirror(oy - 1 - y, band_y)) * pw * 4;
+        let bot_dst = (ph - 1 - y) * pw * 4;
+        out.copy_within(bot_src..bot_src + pw * 4, bot_dst);
+    }
+    out
+}
+
+enum Axis {
+    Row,
+    Column,
+}
+
+/// Ping-pong an index into a band: 0, 1, .. n-1, n-1, .. 1, 0, 0, ..
+fn mirror(i: usize, band: usize) -> usize {
+    let band = band.max(1);
+    let period = band * 2;
+    let at = i % period;
+    match at < band {
+        true => at,
+        false => period - 1 - at,
+    }
+}
