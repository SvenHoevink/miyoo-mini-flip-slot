+/// `src` through the gain into `dst`, byte for byte as `gain_table` would:
+/// `(v * g) >> 8`, alpha's g 256. With blue light on, three table lookups a
+/// pixel took the shelf's copy to the panel from 2.7 ms a frame to 9.3, and
+/// LLVM leaves even the plain multiply loop scalar here, so the bulk is a
+/// NEON loop: sixteen bytes widened, multiplied, narrowed by eight bits.
+/// `neon_kernel_tests` drives it against `grade_row_scalar` under qemu.
+#[cfg(target_arch = "arm")]
+fn grade_row(dst: &mut [u8], src: &[u8], g8: [u16; 3]) {
+    let n = dst.len().min(src.len());
+    let chunks = n / 16;
+    if chunks > 0 {
+        let g = [g8[0], g8[1], g8[2], 256, g8[0], g8[1], g8[2], 256];
+        // SAFETY: `chunks` counts whole groups of sixteen inside both slices,
+        // and the loop runs exactly that many times. The gains are at most
+        // 256, so a product is at most 65,280 and fits the 16-bit lanes.
+        unsafe {
+            core::arch::asm!(
+                ".fpu neon",
+                "vld1.16 {{d20, d21}}, [{g}]",
+                "2:",
+                "vld1.8 {{d0, d1}}, [{s}]!",
+                "vmovl.u8 q8, d0",
+                "vmovl.u8 q9, d1",
+                "vmul.i16 q8, q8, q10",
+                "vmul.i16 q9, q9, q10",
+                "vshrn.i16 d0, q8, #8",
+                "vshrn.i16 d1, q9, #8",
+                "vst1.8 {{d0, d1}}, [{d}]!",
+                "subs {n}, {n}, #1",
+                "bne 2b",
+                g = in(reg) g.as_ptr(),
+                s = inout(reg) src.as_ptr() => _,
+                d = inout(reg) dst.as_mut_ptr() => _,
+                n = inout(reg) chunks => _,
+                out("q0") _,
+                out("q8") _,
+                out("q9") _,
+                out("q10") _,
+                options(nostack),
+            );
+        }
+    }
+    let done = chunks * 16;
+    grade_row_scalar(&mut dst[done..n], &src[done..n], g8);
+}
+
+#[cfg(not(target_arch = "arm"))]
+fn grade_row(dst: &mut [u8], src: &[u8], g8: [u16; 3]) {
+    grade_row_scalar(dst, src, g8)
+}
+
+/// The reference `grade_row` is tested against, its tail, and the fallback
+/// off the device. Starts on a pixel boundary: byte `i`'s channel is `i % 4`.
+fn grade_row_scalar(dst: &mut [u8], src: &[u8], g8: [u16; 3]) {
+    for (i, (d, s)) in dst.iter_mut().zip(src).enumerate() {
+        let g = g8.get(i % 4).copied().unwrap_or(256);
+        *d = ((*s as u32 * g as u32) >> 8) as u8;
+    }
 }
 
