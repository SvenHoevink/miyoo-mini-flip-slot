+        fn present(&mut self, items: &[Draw]) {
+            let (pw, ph) = (out_w(), out_h());
+            let target = fb::Target {
+                ptr: self.panel.as_mut_ptr(),
+                w: pw,
+                h: ph,
+                stride: pw as usize * 4,
+                bgr: true,
