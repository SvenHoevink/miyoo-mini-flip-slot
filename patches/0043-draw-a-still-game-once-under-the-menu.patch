+            for (i, row) in [3, 3, 1, 2, 2, 2, 2, 2, 0].into_iter().enumerate() {
+                let items = menu(r.text, row);
+                r.present(&items);
+                let want = reference(mount, 0, row);
+                let n = differ(&r.panel, &want);
+                assert_eq!(n, 0, "move {i}: {n} pixels differ with the cursor on {row}");
+            }
+            assert!(r.c.under.is_some(), "nothing was kept under the menu");
+            r.frame = pattern(40);
+            let items = menu(r.text, 1);
+            r.present(&items);
+            let want = reference(mount, 40, 1);
+            let n = differ(&r.panel, &want);
+            assert_eq!(n, 0, "{n} pixels differ once the game moved");
+        }
+    }
