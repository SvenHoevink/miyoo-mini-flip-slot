+#[cfg(test)]
+mod cover_tests {
+    use super::cover_rgba;
+
+    /// `cover_rgba` as it was: the window and the average worked out from
+    /// floats for every output pixel. The new one has to produce the same
+    /// bytes, not nearly the same, since the shelf's ground is drawn from it.
+    fn reference(src: &[u8], sw: u32, sh: u32, w: u32, h: u32) -> Vec<u8> {
+        let scale = (w as f32 / sw as f32).max(h as f32 / sh as f32);
+        let ox = (sw as f32 - w as f32 / scale) / 2.0;
+        let oy = (sh as f32 - h as f32 / scale) / 2.0;
+        let mut out = vec![0u8; (w * h * 4) as usize];
+        for y in 0..h {
+            let y0 = oy + y as f32 / scale;
+            let y1 = oy + (y + 1) as f32 / scale;
+            for x in 0..w {
+                let x0 = ox + x as f32 / scale;
+                let x1 = ox + (x + 1) as f32 / scale;
+                let px = box_average(src, sw, sh, x0, y0, x1, y1);
+                out[((y * w + x) * 4) as usize..][..4].copy_from_slice(&px);
+            }
+        }
+        out
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn box_average(src: &[u8], sw: u32, sh: u32, x0: f32, y0: f32, x1: f32, y1: f32) -> [u8; 4] {
+        let xa = (x0.floor().max(0.0) as u32).min(sw - 1);
+        let ya = (y0.floor().max(0.0) as u32).min(sh - 1);
+        let xb = ((x1.ceil() as u32).max(xa + 1)).min(sw);
+        let yb = ((y1.ceil() as u32).max(ya + 1)).min(sh);
+
+        let mut acc = [0u32; 4];
+        let mut n = 0u32;
+        for y in ya..yb {
+            for x in xa..xb {
+                let i = ((y * sw + x) * 4) as usize;
+                for c in 0..4 {
+                    acc[c] += src[i + c] as u32;
+                }
+                n += 1;
+            }
+        }
+        let mut out = [0u8; 4];
+        for c in 0..4 {
+            out[c] = ((acc[c] + n / 2) / n) as u8;
+        }
+        out
+    }
+
+    fn image(w: u32, h: u32) -> Vec<u8> {
+        (0..w * h * 4)
+            .map(|i| (i.wrapping_mul(2_654_435_761) >> 13) as u8)
+            .collect()
+    }
+
+    #[test]
+    fn it_matches_the_per_pixel_version() {
+        // Up, down, the backgrounds' own 720x480 to both panels, and odd
+        // shapes either way round.
+        let cases = [
+            (720, 480, 752, 560),
+            (720, 480, 640, 480),
+            (720, 480, 360, 212),
+            (300, 200, 752, 560),
+            (1000, 750, 312, 337),
+            (17, 9, 40, 40),
+            (40, 40, 17, 9),
+            (1, 1, 5, 3),
+        ];
+        for (sw, sh, w, h) in cases {
+            let src = image(sw, sh);
+            let got = cover_rgba(&src, sw, sh, w, h).expect("a non-empty source");
+            assert!(got == reference(&src, sw, sh, w, h), "{sw}x{sh} -> {w}x{h}");
+        }
+    }
+
+    #[test]
+    fn the_real_backgrounds_come_out_the_same() {
+        for png in [
+            &include_bytes!("../../../assets/background_default.png")[..],
+            &include_bytes!("../../../assets/background_default_blur.png")[..],
+        ] {
+            let (src, sw, sh) = super::decode_png_bytes(png).expect("the asset decodes");
+            for (w, h) in [(752, 560), (640, 480)] {
+                let got = cover_rgba(&src, sw, sh, w, h).expect("a non-empty source");
+                assert!(got == reference(&src, sw, sh, w, h), "{w}x{h}");
+            }
+        }
+    }
+}
