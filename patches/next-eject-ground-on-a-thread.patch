+    /// `upload_ground` on a thread, for the way back from a game.
+    ///
+    /// Done in line, the first frame after a game decoded and resized both
+    /// 720x480 PNGs: on the handheld that frame took 426 ms to render, a
+    /// visible freeze on every eject. On this panel an eject first powers
+    /// the screen off over the game with nothing of the shelf drawn, so
+    /// building them meanwhile costs no frame at all. Anything that draws
+    /// them before they land still waits, so no frame shows less than it did.
+    fn start_ground(&mut self, compositor: &mut Compositor) {
+        let (tx, built) = std::sync::mpsc::channel();
+        let spawned = std::thread::Builder::new()
+            .name("slot-ground".into())
+            .spawn(move || {
+                let _ = tx.send((slot_ui::default_background(), slot_ui::blur_background()));
+            });
+        if spawned.is_err() {
+            return self.upload_ground(compositor);
+        }
+        let clear = vec![0u8; (out_w() * out_h() * 4) as usize];
+        let ground = compositor.create_texture(out_w(), out_h(), &clear);
+        let blur = compositor.create_texture(out_w(), out_h(), &clear);
+        self.session.app_mut().set_ground(ground);
+        self.session.app_mut().set_blur(blur);
+        self.ground_build = Some(GroundBuild {
+            built,
+            ground,
+            blur,
+        });
+    }
+
+    fn land_ground(&mut self, compositor: &mut Compositor, wait: bool) {
+        let Some(b) = &self.ground_build else {
+            return;
+        };
+        let built = match wait {
+            true => b.built.recv().ok(),
+            false => match b.built.try_recv() {
+                Ok(built) => Some(built),
+                Err(std::sync::mpsc::TryRecvError::Empty) => return,
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => None,
+            },
+        };
+        let (ground, blur) = (b.ground, b.blur);
+        self.ground_build = None;
+        let Some((ground_rgba, blur_rgba)) = built else {
+            return;
+        };
+        // Missing art leaves its texture transparent, which draws as nothing
+        // -- what `upload_ground` did by not setting it.
+        for (tex, rgba) in [(ground, ground_rgba), (blur, blur_rgba)] {
+            if let Some(rgba) = rgba {
+                compositor.update_texture(tex, out_w(), out_h(), &rgba);
+            }
+        }
+    }
