+    /// A cart face as the shelf draws it: opaque in the middle, transparent
+    /// corners, a soft edge, shrunk to the side carts' 0.78 and the near
+    /// centre's 0.99 at fractional positions. Most of its rows take the
+    /// gathered memcpy, the corner rows the per-texel rule.
+    #[test]
+    fn a_shrunk_cart_face_matches_the_reference() {
+        let (w, h) = (61u32, 69u32);
+        let mut face = Image::new(w, h);
+        for y in 0..h {
+            for x in 0..w {
+                let i = ((y * w + x) * 4) as usize;
+                let (dx, dy) = (x.min(w - 1 - x), y.min(h - 1 - y));
+                let a = match dx.min(dy) {
+                    0 if dx + dy < 4 => 0,
+                    0 => 128,
+                    1 => 254,
+                    _ => 255,
+                };
+                face.px[i..i + 4].copy_from_slice(&[(x * 4) as u8, (y * 3) as u8, 77, a]);
+            }
+        }
+        let mut scratch = Scratch::default();
+        for (scale, x, y) in [
+            (0.78f32, 3.3f32, 1.6f32),
+            (0.99, 0.5, 0.25),
+            (0.78, -9.7, 4.1),
+        ] {
+            let (dw, dh) = (w as f32 * scale, h as f32 * scale);
+            let mut want = canvas(80, 80);
+            let mut got = canvas(80, 80);
+            reference(&mut want, &face, x, y, dw, dh, [1.0, 1.0, 1.0, 1.0]);
+            super::blit(
+                &mut got,
+                &face,
+                x,
+                y,
+                dw,
+                dh,
+                [1.0, 1.0, 1.0, 1.0],
+                &mut scratch,
+            );
+            assert_eq!(got.px, want.px, "scale {scale} at {x},{y}");
+        }
+    }
+
