+/// The scroll hitch: `CartFaces::sync` blocks the frame on every on-screen
+/// face it does not have, so a cart that only becomes wanted when it comes on
+/// screen is a stalled frame. Each one has to have been asked for, off screen,
+/// a step earlier.
+#[test]
+fn a_cart_stepped_on_screen_was_already_being_built() {
+    let mut app = library(500, 0);
+    for b in [Btn::Right, Btn::Right, Btn::Left, Btn::Left, Btn::Left] {
+        let before: Vec<usize> = app.face_wants().iter().map(|w| w.index).collect();
+        app.apply(Action::GbaDown(b));
+        app.apply(Action::GbaUp(b));
+        for w in app.face_wants().iter().filter(|w| w.on_screen) {
+            assert!(
+                before.contains(&w.index),
+                "cart {} came on screen after {b:?} without being asked for first",
+                w.index
+            );
+        }
+    }
+}
