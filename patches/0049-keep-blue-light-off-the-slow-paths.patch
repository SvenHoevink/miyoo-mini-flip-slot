+pub fn tinted(tex: &Image, rgb: [f32; 3]) -> Image {
+    let mut out = Image::new(tex.w, tex.h);
+    for (o, t) in out.px.chunks_exact_mut(4).zip(tex.px.chunks_exact(4)) {
+        let m = modulate([t[0], t[1], t[2], t[3]], [rgb[0], rgb[1], rgb[2], 1.0]);
+        o.copy_from_slice(&[m[0], m[1], m[2], t[3]]);
+    }
+    out
+}
