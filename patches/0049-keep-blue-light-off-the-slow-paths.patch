+/// Build the texture's pre-tinted copy for `colour`'s rgb if the tint
+/// changed, and hand it back -- None for an untinted draw, which the blit
+/// never tints.
+fn tinted_for(t: &mut Tex, colour: [f32; 4]) -> (&Image, Option<&Image>) {
+    let rgb = [colour[0], colour[1], colour[2]];
+    let tinted = rgb != [1.0; 3];
+    let key = rgb.map(f32::to_bits);
+    if tinted && t.tinted.as_ref().is_none_or(|(k, _)| *k != key) {
+        t.tinted = Some((key, raster::tinted(&t.img, rgb)));
+    }
+    let pre = t.tinted.as_ref().filter(|_| tinted).map(|(_, img)| img);
+    (&t.img, pre)
+}
