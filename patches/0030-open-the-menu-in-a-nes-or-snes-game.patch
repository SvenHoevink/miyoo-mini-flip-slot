 #[test]
+fn a_console_game_draws_its_menu_without_asking_for_an_lcd_row_forever() {
+    for (platform, ext) in [(Platform::Nes, "nes"), (Platform::Snes, "sfc")] {
+        let d = tmp_root_with_carts(&[]);
+        let dir = d.path().join("Games").join(platform.dir_name());
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join(format!("Console.{ext}")), [0u8; 0x8000]).unwrap();
+        slot_store::write_slot_state(
+            d.path(),
+            &slot_store::SlotState {
+                cart: Some("Console".into()),
+                cart_platform: Some(platform),
+                clock_set: true,
+                ..Default::default()
+            },
+        )
+        .unwrap();
+        let mut a = App::boot(d.path());
+        a.on_core_ready();
+        for _ in 0..120 {
+            a.update(1.0 / 60.0);
+        }
+        assert_eq!(a.playing_platform(), platform);
+        assert_eq!(a.quick_value(QuickRow::Shader), None);
+        assert_eq!(a.quick_value(QuickRow::ColourCorrection), None);
+        a.apply(Action::QuickMenu);
+        for _ in 0..30 {
+            a.update(1.0 / 60.0);
+        }
+        let mut out = Vec::new();
+        a.draw(&mut out);
+        assert_eq!(a.in_game_menu(), Some(QuickRow::Resume), "{platform:?}");
+    }
+}
