+    /// For the trace, at most once a second: why a canvas frame with no game
+    /// was not a repeat of the last one. The shelf sitting still was never
+    /// taken as unchanged on the Flip, and nothing said what moved.
+    fn say_change(&mut self, items: &[Draw], params: [u32; 6]) {
+        let Some(u) = &self.unchanged else {
+            return;
+        };
+        if !self.profiling || self.frames - self.change_said_at < 60 {
+            return;
+        }
+        self.change_said_at = self.frames;
+        const PARAM: [&str; 6] = ["gain b", "gain g", "gain r", "shake", "slide", "screen"];
+        let what = if u.tex_gen != self.tex_gen {
+            format!("{} texture change(s)", self.tex_gen - u.tex_gen)
+        } else if let Some(i) = (0..6).find(|&i| u.params[i] != params[i]) {
+            format!(
+                "{} {} -> {}",
+                PARAM[i],
+                f32::from_bits(u.params[i]),
+                f32::from_bits(params[i])
+            )
+        } else if u.items.len() != items.len() {
+            format!("{} items -> {}", u.items.len(), items.len())
+        } else {
+            match u.items.iter().zip(items).position(|(a, b)| a != b) {
+                Some(i) => format!(
+                    "item {i} of {}: {:?} -> {:?}",
+                    items.len(),
+                    u.items[i],
+                    items[i]
+                ),
+                None => "nothing".to_string(),
+            }
+        };
+        eprintln!("slot: soft: canvas frame changed: {what}");
+    }
