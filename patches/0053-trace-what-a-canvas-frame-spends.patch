+    /// The heavy-frame trace names the frame's slowest draws, slowest first:
+    /// a full-canvas texture before a small label.
+    #[test]
+    fn the_trace_keeps_the_slowest_draws_slowest_first() {
+        let mut r = Rig::new(Mount::Half);
+        r.c.profiling = true;
+        let (pw, ph) = (out_w(), out_h());
+        let wall =
+            r.c.create_texture(pw, ph, &vec![120u8; (pw * ph * 4) as usize]);
+        let items = vec![
+            Draw::Tex {
+                x: 0.0,
+                y: 0.0,
+                w: pw as f32,
+                h: ph as f32,
+                tex: wall,
+                alpha: 0.5,
+            },
+            Draw::Tex {
+                x: 10.0,
+                y: 10.0,
+                w: 60.0,
+                h: 20.0,
+                tex: r.text,
+                alpha: 1.0,
+            },
+        ];
+        r.present(&items);
+        let s = r.c.slowest;
+        assert_eq!(s[0].1, "tex");
+        assert_eq!(s[0].2, (pw, ph), "the wall was not the slowest draw");
+        assert!(
+            s[0].0 >= s[1].0 && s[1].0 >= s[2].0,
+            "not slowest first: {s:?}"
+        );
+    }
