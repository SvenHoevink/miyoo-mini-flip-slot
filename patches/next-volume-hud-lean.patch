+    /// Frames of `lists` on one compositor, each list built from the game,
+    /// a full-canvas shell texture and an icon texture; returns the panel and
+    /// the compositor for a look at what it kept.
+    type List = fn(TexId, TexId) -> Vec<Draw>;
+
+    fn run(mount: Mount, lists: &[List]) -> (Vec<u8>, Compositor) {
+        let (pw, ph) = (out_w(), out_h());
+        let mut panel = vec![0u8; pw as usize * ph as usize * 4];
+        let target = fb::Target {
+            ptr: panel.as_mut_ptr(),
+            w: pw,
+            h: ph,
+            stride: pw as usize * 4,
+            bgr: true,
+        };
+        // SAFETY: `panel` outlives every frame drawn into it.
+        unsafe { fb::set_current_for_test(Some(target)) };
+        let mut c = Compositor::new(&NoSurface).expect("compositor");
+        c.mount = mount;
+        let mut frame = vec![0u8; (SRC_W * SRC_H * 4) as usize];
+        for (i, px) in frame.chunks_exact_mut(4).enumerate() {
+            let (x, y) = (i as u32 % SRC_W, i as u32 / SRC_W);
+            px.copy_from_slice(&[(x * 7) as u8, (y * 5) as u8, (x ^ y) as u8, 255]);
+        }
+        c.upload_game(&frame, (SRC_W, SRC_H));
+        let mut shell = vec![0u8; pw as usize * ph as usize * 4];
+        for (i, px) in shell.chunks_exact_mut(4).enumerate() {
+            px.copy_from_slice(&[(i % 251) as u8, 90, (i % 13) as u8 * 19, 255]);
+        }
+        let shell = c.create_texture(pw, ph, &shell);
+        let icon = c.create_texture(20, 30, &[200u8; 20 * 30 * 4]);
+        for list in lists {
+            c.begin_frame();
+            c.draw_list(&list(shell, icon));
+            c.end_frame((pw, ph));
+        }
+        // SAFETY: clearing the pointer before `panel` is dropped.
+        unsafe { fb::set_current_for_test(None) };
+        (panel, c)
+    }
+
+    fn shell_only(shell: TexId, _: TexId) -> Vec<Draw> {
+        let (w, h) = (out_w() as f32, out_h() as f32);
+        vec![
+            Draw::Game,
+            Draw::Tex {
+                x: 0.0,
+                y: 0.0,
+                w,
+                h,
+                tex: shell,
+                alpha: 1.0,
+            },
+        ]
+    }
+
+    fn shell_and_hud(shell: TexId, icon: TexId) -> Vec<Draw> {
+        let mut items = shell_only(shell, icon);
+        items.push(Draw::Rect {
+            x: 0.0,
+            y: 0.0,
+            w: out_w() as f32,
+            h: 40.0,
+            colour: [0.0, 0.0, 0.0, 0.05],
+        });
+        items.push(Draw::Tex {
+            x: 310.0,
+            y: 5.0,
+            w: 20.0,
+            h: 30.0,
+            tex: icon,
+            alpha: 0.1,
+        });
+        items
+    }
+
+    /// A GBA cart draws its HUD over the Advance shell. The shell belongs in
+    /// the surround, so the overlay is the HUD alone rather than the canvas.
+    #[test]
+    fn a_hud_over_the_shell_leaves_the_shell_in_the_surround() {
+        let (_, c) = run(Mount::Normal, &[shell_and_hud]);
+        assert!(c.direct_game);
+        assert_eq!(c.overlay.len(), 2, "the shell went into the overlay");
+    }
+
+    /// Once the HUD has gone, nothing of it may stay on the panel: the frames
+    /// after it must match frames that never had one.
+    #[test]
+    fn a_hud_that_has_gone_leaves_nothing_behind() {
+        let mut after = vec![shell_and_hud as List; 3];
+        after.extend([shell_only as List; PAGES as usize + 1]);
+        for mount in [Mount::Normal, Mount::Half] {
+            let (a, c) = run(mount, &after);
+            let (b, _) = run(mount, &[shell_only as List; PAGES as usize + 1]);
+            assert!(c.overlay.is_empty(), "the HUD is still an overlay");
+            let differ = a
+                .chunks_exact(4)
+                .zip(b.chunks_exact(4))
+                .filter(|(p, q)| p[..3] != q[..3])
+                .count();
+            assert_eq!(
+                differ, 0,
+                "{differ} pixels of the HUD are left on the panel"
+            );
+        }
+    }
+
+    /// A HUD that has not changed and lies off the picture is already on every
+    /// page, so it is not composed again.
+    /// A new compositor repaints the surround for its first PAGES frames, and the
+    /// HUD with it, so it settles PAGES frames after that.
+    #[test]
+    fn a_still_hud_off_the_picture_costs_nothing() {
+        fn hud(_: TexId, icon: TexId) -> Vec<Draw> {
+            vec![
+                Draw::Game,
+                Draw::Tex {
+                    x: 310.0,
+                    y: 2.0,
+                    w: 20.0,
+                    h: 30.0,
+                    tex: icon,
+                    alpha: 1.0,
+                },
+            ]
+        }
+        let (_, c) = run(Mount::Normal, &[hud as List; 2 * PAGES as usize + 1]);
+        let (_, gy, _, _) = c.game.rect();
+        assert!(
+            gy > 33.0,
+            "the picture starts at {gy}, under the HUD; the test needs it clear"
+        );
+        assert_eq!(c.frame_stages()[2], 0, "the still HUD was composed again");
+    }
