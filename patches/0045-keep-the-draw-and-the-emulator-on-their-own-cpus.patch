+/// core frame: renders of 16.9 ms against 6.8, catch-up ticks of 9.8 ms,
+/// 24 missed latches in ten seconds of Donkey Kong Country right after the
+/// menu and none in the eighty before it.
+pub const DRAW_CPU: usize = 0;
+pub const EMU_CPU: usize = 1;
+
 /// Set the calling thread's nice value. Best effort: a failure leaves the
