@@ -27,8 +37,63 @@
 
 pub fn background() {
     set(BACKGROUND);
+    unpin();
 }
 
+/// Keep the calling thread to `cpu`, on a machine with more than one. A
+/// thread inherits its creator's CPUs as it does its nice value, so anything
+/// a pinned thread spawns that is not the draw or the emulator says
+/// `unpin` -- `background` does.
+pub fn pin(cpu: usize) {
+    let n = cpus();
+    if n > 1 {
+        affinity(cpu.min(n - 1)..cpu.min(n - 1) + 1);
+    }
+}
+
+/// Let the calling thread run on any CPU again.
+pub fn unpin() {
+    affinity(0..cpus());
+}
+
+/// Every CPU the machine has. Not `available_parallelism`, which counts
+/// only the ones the calling thread may use: from a pinned thread that is
+/// one, and unpinning to it freed nothing.
+fn cpus() -> usize {
+    // SAFETY: sysconf takes no pointers.
+    #[cfg(target_os = "linux")]
+    let n = unsafe { libc::sysconf(libc::_SC_NPROCESSORS_CONF) };
+    #[cfg(not(target_os = "linux"))]
+    let n = 1;
+    usize::try_from(n).map_or(1, |n| n.max(1))
+}
+
+fn affinity(cpus: std::ops::Range<usize>) {
+    // SAFETY: a zeroed cpu_set_t is the empty set, CPU_SET writes inside it,
+    // and sched_setaffinity on the calling thread, 0 meaning "me", reads it.
+    #[cfg(target_os = "linux")]
+    unsafe {
+        let mut set: libc::cpu_set_t = std::mem::zeroed();
+        for cpu in cpus {
+            libc::CPU_SET(cpu, &mut set);
+        }
+        libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &set);
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = cpus;
+}
+
+/// How many times the calling thread has been preempted -- taken off a CPU
+/// it still wanted. For the pace trace: a draw sharing its CPU with the
+/// emulator shows here and nowhere else.
+pub fn preempted() -> Option<u64> {
+    let status = std::fs::read_to_string("/proc/thread-self/status").ok()?;
+    status
+        .lines()
+        .find_map(|l| l.strip_prefix("nonvoluntary_ctxt_switches:"))
+        .and_then(|v| v.trim().parse().ok())
+}
+
