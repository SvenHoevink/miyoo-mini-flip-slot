+/// The width of the leading `timeval` is a parameter so both layouts can be
+/// tested from either host; on a 64-bit build machine the 32-bit case is
+/// otherwise unreachable, which is how it went unnoticed.
+fn decode_after_time(bytes: &[u8], time_bytes: usize) -> Option<Ev> {
+    let packet = bytes.get(..time_bytes + 8)?;
+    let at = |i: usize| packet[time_bytes + i];
     Some(Ev {
-        kind: u16::from_le_bytes([packet[16], packet[17]]),
-        code: u16::from_le_bytes([packet[18], packet[19]]),
-        value: i32::from_le_bytes([packet[20], packet[21], packet[22], packet[23]]),
+        kind: u16::from_le_bytes([at(0), at(1)]),
+        code: u16::from_le_bytes([at(2), at(3)]),
+        value: i32::from_le_bytes([at(4), at(5), at(6), at(7)]),
     })
 }
 
