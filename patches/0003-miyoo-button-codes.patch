+/// The Miyoo Mini family wires its buttons to `gpio_keys` with *keyboard*
+/// codes, not the `BTN_*` gamepad codes the Anbernic handhelds report, so none
+/// of the mapping below matches and every press is dropped. These are the 18
+/// keys the Mini Flip's `soc:gpio_keys` advertises, cross-checked against
+/// Allium's own Miyoo map. The codes cannot collide with the gamepad ones
+/// (0x130+), but this stays behind a feature so other devices are unaffected.
+#[cfg(feature = "miyoo")]
+pub fn code_to_btn(code: u16) -> Option<Btn> {
+    Some(match code {
+        103 => Btn::Up,
+        108 => Btn::Down,
+        105 => Btn::Left,
+        106 => Btn::Right,
+        57 => Btn::A,      // KEY_SPACE
+        29 => Btn::B,      // KEY_LEFTCTRL
+        42 => Btn::X,      // KEY_LEFTSHIFT
+        56 => Btn::Y,      // KEY_LEFTALT
+        18 => Btn::L1,     // KEY_E
+        20 => Btn::R1,     // KEY_T
+        15 => Btn::L2,     // KEY_TAB
+        14 => Btn::R2,     // KEY_BACKSPACE
+        28 => Btn::Start,  // KEY_ENTER
+        97 => Btn::Select, // KEY_RIGHTCTRL
+        1 => Btn::Menu,    // KEY_ESC
+        115 => Btn::VolUp,
+        114 => Btn::VolDown,
+        116 => Btn::Power,
+        _ => return None,
+    })
+}
+
