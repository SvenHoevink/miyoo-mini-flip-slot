+#[cfg(test)]
+mod input_event_layout_tests {
+    use super::{code_to_btn, decode_after_time, Ev, EV_KEY};
+
+    /// One `struct input_event` as a 32-bit kernel writes it: 8 bytes of
+    /// timeval, then type, code, value. This is KEY_SPACE (the Miyoo A button)
+    /// going down, with a plausible timestamp.
+    fn press_32bit() -> Vec<u8> {
+        let mut b = Vec::new();
+        b.extend_from_slice(&47657u32.to_le_bytes()); // tv_sec
+        b.extend_from_slice(&565800u32.to_le_bytes()); // tv_usec
+        b.extend_from_slice(&EV_KEY.to_le_bytes());
+        b.extend_from_slice(&57u16.to_le_bytes()); // KEY_SPACE
+        b.extend_from_slice(&1i32.to_le_bytes()); // down
+        b
+    }
+
+    #[test]
+    fn decodes_a_32_bit_record() {
+        let ev = decode_after_time(&press_32bit(), 8).expect("short packet");
+        assert_eq!(
+            (ev.kind, ev.code, ev.value),
+            (EV_KEY, 57, 1),
+            "32-bit input_event decoded wrong"
+        );
+        #[cfg(feature = "miyoo")]
+        assert!(code_to_btn(ev.code).is_some(), "KEY_SPACE should map");
+    }
+
+    #[test]
+    fn the_old_64_bit_assumption_turns_a_press_into_noise() {
+        // What the device actually logged: type=0xba29 code=0x3a36, which is
+        // the timestamp read through the wrong offsets. Needs 24 bytes, so feed
+        // it two records' worth and read the first as 64-bit.
+        let mut stream = press_32bit();
+        stream.extend_from_slice(&press_32bit());
+        let ev: Ev = decode_after_time(&stream, 16).expect("short packet");
+        assert_ne!(ev.kind, EV_KEY, "the bug should not decode as a key event");
+    }
+}
