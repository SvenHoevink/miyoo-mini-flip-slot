+/// The calling thread's time on a CPU and its time waiting in a run queue
+/// for one, in ns, from `/proc/thread-self/schedstat`. What is left of a
+/// span after both was spent blocked or asleep -- which tells a long present
+/// that waited on something from one that could not get a CPU.
+pub fn schedstat() -> Option<(u64, u64)> {
+    let s = std::fs::read_to_string("/proc/thread-self/schedstat").ok()?;
+    let mut it = s.split_whitespace().map(|v| v.parse::<u64>().ok());
+    Some((it.next()??, it.next()??))
+}
+
 /// How many times the calling thread has been preempted -- taken off a CPU
 /// it still wanted. For the pace trace: a draw sharing its CPU with the
 /// emulator shows here and nowhere else.
@@ -153,6 +163,21 @@
     }
 
     #[test]
+    fn schedstat_counts_time_on_a_cpu() {
+        let (r0, _) = schedstat().expect("no /proc/thread-self/schedstat");
+        let until = std::time::Instant::now() + std::time::Duration::from_millis(20);
+        while std::time::Instant::now() < until {
+            std::hint::black_box(0u64);
+        }
+        let (r1, _) = schedstat().unwrap();
+        assert!(
+            r1 - r0 >= 10_000_000,
+            "20 ms of spinning read as {} ns",
+            r1 - r0
+        );
+    }
+
+    #[test]
     fn preemption_is_counted() {
         assert!(preempted().is_some(), "no nonvoluntary_ctxt_switches line");
     }
