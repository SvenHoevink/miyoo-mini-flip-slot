--- /dev/null
+++ b/crates/slot/src/niceness.rs
@@ -0,0 +1,64 @@
+//! Thread priorities on a two-core handheld.
+//!
+//! Linux takes a nice value per thread, and a thread inherits its creator's.
+//! The emulator raises itself to -8, so anything it spawns -- the rewind
+//! worker, which copies, XORs and LZ4s a 529 KB SNES state every eleven
+//! frames -- outranked the thread drawing the frame. Work nobody waits on
+//! for the next present says so here instead of inheriting.
+
+/// The thread that draws and presents. Above the system's own daemons and
+/// below the emulator, the audio sink and the input readers.
+pub const RENDER: i32 = -4;
+/// Rewind, card writes, cart faces, prefetch: work that can land a frame
+/// late without anyone seeing it.
+pub const BACKGROUND: i32 = 10;
+
+/// Set the calling thread's nice value. Best effort: a failure leaves the
+/// thread where it was, which is what upstream always did.
+pub fn set(nice: i32) {
+    // SAFETY: setpriority on the calling thread, 0 meaning "me".
+    #[cfg(target_os = "linux")]
+    unsafe {
+        libc::setpriority(libc::PRIO_PROCESS as _, 0, nice);
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = nice;
+}
+
+pub fn background() {
+    set(BACKGROUND);
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::*;
+
+    fn mine() -> i32 {
+        // SAFETY: getpriority on the calling thread.
+        unsafe { libc::getpriority(libc::PRIO_PROCESS as _, 0) }
+    }
+
+    #[test]
+    fn background_lowers_only_the_calling_thread() {
+        let before = mine();
+        let inside = std::thread::spawn(|| {
+            background();
+            mine()
+        })
+        .join()
+        .unwrap();
+        assert_eq!(inside, BACKGROUND.max(before));
+        assert_eq!(mine(), before, "the caller kept its own priority");
+    }
+
+    #[test]
+    fn a_spawned_thread_inherits_unless_it_says_otherwise() {
+        let child = std::thread::spawn(|| {
+            set(BACKGROUND);
+            std::thread::spawn(mine).join().unwrap()
+        })
+        .join()
+        .unwrap();
+        assert_eq!(child, BACKGROUND, "this is why the rewind worker must say");
+    }
+}
