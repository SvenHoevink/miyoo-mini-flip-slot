+/// Records which thread asked it for a state, and can travel to another.
+#[derive(Clone)]
+struct Travelling {
+    asked_on: Arc<std::sync::Mutex<Vec<std::thread::ThreadId>>>,
+}
+
+impl Snapshot for Travelling {
+    fn state(&self) -> Option<Vec<u8>> {
+        self.asked_on
+            .lock()
+            .unwrap()
+            .push(std::thread::current().id());
+        Some(vec![7; 64])
+    }
+
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        None
+    }
+
+    fn thumb(&self) -> Option<Vec<u8>> {
+        None
+    }
+
+    fn load(&self, _state: Vec<u8>) {}
+
+    fn detach(&self) -> Option<Box<dyn Snapshot + Send>> {
+        Some(Box::new(self.clone()))
+    }
+}
+
+#[test]
+fn the_autosave_asks_a_travelling_core_off_the_draw_thread() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let asked_on = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let snap = Travelling {
+        asked_on: asked_on.clone(),
+    };
+    let mut a = app_playing_with(d.path(), "Emerald", Box::new(snap));
+    asked_on.lock().unwrap().clear();
+    a.tick_ms(60_000);
+    a.settle_saves();
+    let asked = asked_on.lock().unwrap().clone();
+    assert_eq!(asked.len(), 1, "one state per autosave");
+    assert_ne!(
+        asked[0],
+        std::thread::current().id(),
+        "the draw waited on the emulator for its state"
+    );
+    assert_eq!(
+        StateRing::new(d.path(), Platform::Gba, Core::Mgba, "Emerald")
+            .read_resume()
+            .unwrap(),
+        Some(vec![7; 64])
+    );
+}
