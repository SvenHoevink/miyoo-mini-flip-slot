+/// The last reading from the vendor tool, and whether one is in flight.
+struct Gauge {
+    last: std::sync::Mutex<Option<Battery>>,
+    busy: std::sync::atomic::AtomicBool,
+}
+
+static AXP: Gauge = Gauge {
+    last: std::sync::Mutex::new(None),
+    busy: std::sync::atomic::AtomicBool::new(false),
+};
+
+/// `axp_test` is a process: a spawn, a dynamic link and an i2c transaction,
+/// and the battery is polled from the thread that draws. Waited for there,
+/// every ten seconds, that is a frame the panel may not get. So only the
+/// first reading is waited for; after that each poll answers with the last
+/// one and starts the next behind it, which leaves the gauge one poll stale.
+fn axp_gauge(read: fn() -> Option<Battery>) -> Option<Battery> {
+    use std::sync::atomic::Ordering;
+    let lock = || AXP.last.lock().unwrap_or_else(|e| e.into_inner());
+    let last = *lock();
+    if last.is_none() {
+        let now = read();
+        *lock() = now;
+        return now;
+    }
+    if !AXP.busy.swap(true, Ordering::AcqRel) {
+        let spawned = std::thread::Builder::new()
+            .name("slot-battery".into())
+            .spawn(move || {
+                // SAFETY: setpriority on the calling thread, 0 meaning "me".
+                unsafe {
+                    libc::setpriority(libc::PRIO_PROCESS as _, 0, 10);
+                }
+                if let Some(b) = read() {
+                    *AXP.last.lock().unwrap_or_else(|e| e.into_inner()) = Some(b);
+                }
+                AXP.busy.store(false, Ordering::Release);
+            });
+        if spawned.is_err() {
+            AXP.busy.store(false, Ordering::Release);
+            return read();
+        }
+    }
+    last
+}
