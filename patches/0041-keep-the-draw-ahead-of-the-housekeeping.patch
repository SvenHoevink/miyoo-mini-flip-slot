+#[cfg(test)]
+mod axp_gauge_tests {
+    use super::{axp_gauge, Battery, Charge};
+    use std::sync::atomic::{AtomicU8, Ordering};
+    use std::time::{Duration, Instant};
+
+    static READS: AtomicU8 = AtomicU8::new(0);
+
+    /// A tool that takes a quarter of a second, as a slow i2c read might.
+    fn slow_tool() -> Option<Battery> {
+        std::thread::sleep(Duration::from_millis(250));
+        Some(Battery {
+            percent: 50 + READS.fetch_add(1, Ordering::SeqCst),
+            charge: Charge::Discharging,
+        })
+    }
+
+    #[test]
+    fn only_the_first_reading_is_waited_for() {
+        let first = axp_gauge(slow_tool).unwrap();
+        assert_eq!(first.percent, 50, "nothing to answer with yet, so it waits");
+
+        let t = Instant::now();
+        let second = axp_gauge(slow_tool).unwrap();
+        assert!(
+            t.elapsed() < Duration::from_millis(100),
+            "the poll waited {:?} on the tool",
+            t.elapsed()
+        );
+        assert_eq!(second, first, "answered with the last reading");
+
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut latest = second;
+        while latest.percent == 50 && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(20));
+            latest = axp_gauge(slow_tool).unwrap();
+        }
+        assert_eq!(latest.percent, 51, "the read behind it lands");
+    }
+}
