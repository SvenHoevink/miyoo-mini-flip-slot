+    /// A canvas frame that repeats the one every page holds draws nothing;
+    /// anything it depends on changing draws it again, and the panel is then
+    /// what drawing it would make.
+    #[test]
+    fn an_unchanged_shelf_frame_is_not_drawn_again() {
+        let mut r = Rig::new(Mount::Half);
+        r.c.set_blue_light(5);
+        let still = |r: &mut Rig| {
+            for _ in 0..2 * PAGES + 1 {
+                let items = shelf(r.text, 100.0);
+                r.present(&items);
+            }
+            r.panel.fill(0xab);
+            let items = shelf(r.text, 100.0);
+            r.present(&items);
+            r.panel.iter().all(|&b| b == 0xab)
+        };
+        assert!(still(&mut r), "a repeat of the last frame was drawn again");
+
+        // A texture's pixels changing draws it again.
+        let art = vec![90u8; 60 * 20 * 4];
+        r.c.update_texture(r.text, 60, 20, &art);
+        let items = shelf(r.text, 100.0);
+        r.present(&items);
+        assert!(
+            r.panel.iter().any(|&b| b != 0xab),
+            "a changed texture was not drawn"
+        );
+        assert!(still(&mut r), "it was not skipped again once settled");
+
+        // So does the list moving, and the blue light changing.
+        r.present(&shelf(r.text, 101.0));
+        assert!(
+            r.panel.iter().any(|&b| b != 0xab),
+            "a moved sprite was not drawn"
+        );
+        for _ in 0..2 * PAGES + 1 {
+            r.present(&shelf(r.text, 101.0));
+        }
+        r.panel.fill(0xab);
+        r.present(&shelf(r.text, 101.0));
+        assert!(
+            r.panel.iter().all(|&b| b == 0xab),
+            "the moved frame did not settle"
+        );
+        r.c.set_blue_light(6);
+        r.present(&shelf(r.text, 101.0));
+        assert!(
+            r.panel.iter().any(|&b| b != 0xab),
+            "a new blue light step was not drawn"
+        );
+
+        // And what it draws then is the frame, not what was skipped.
+        let want = reference_of_list(Mount::Half, 6, shelf(r.text, 101.0));
+        let n = differ(&r.panel, &want);
+        assert_eq!(n, 0, "{n} pixels differ after the frame changed");
+    }
