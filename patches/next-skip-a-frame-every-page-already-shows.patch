+    /// screen, and drawn for PAGES frames since it last changed. A repaint
+    /// pending draws regardless.
+    fn repeats(&mut self, items: &[Draw]) -> bool {
+        if items.iter().any(|d| matches!(d, Draw::Game)) {
+            self.unchanged = None;
+            return false;
+        }
+        let bits = f32::to_bits;
+        let params = [
+            bits(self.gain[0]),
+            bits(self.gain[1]),
+            bits(self.gain[2]),
+            bits(self.shake),
+            bits(self.lift),
+            bits(self.screen),
+        ];
+        let same = self
+            .unchanged
+            .as_ref()
+            .is_some_and(|u| u.tex_gen == self.tex_gen && u.params == params && u.items == items);
+        if !same {
+            self.unchanged = Some(Unchanged {
+                items: items.to_vec(),
+                tex_gen: self.tex_gen,
+                params,
+            });
+            self.unchanged_left = PAGES;
+            return false;
+        }
+        if self.unchanged_left > 0 {
+            self.unchanged_left -= 1;
+            return false;
+        }
+        self.clear_left == 0
+    }
