diff --git a/crates/slot-gfx/src/soft/fb.rs b/crates/slot-gfx/src/soft/fb.rs
new file mode 100644
index 0000000..01d482e
--- /dev/null
+++ b/crates/slot-gfx/src/soft/fb.rs
@@ -0,0 +1,316 @@
+//! A `Surface` over `/dev/fb0` for devices with no GPU.
+//!
+//! The Miyoo Mini Flip's SigmaStar SSD202D has no 3D core and no libEGL, so the
+//! GL path in `fbdev.rs` cannot start. This maps the framebuffer directly and
+//! flips pages instead.
+//!
+//! The panel there reports `virtual_size 752,1680` — three 752x560 buffers
+//! stacked — so `swap` writes the back buffer and hands it to the scanout with
+//! `FBIOPAN_DISPLAY`, which is both tear-free and cheaper than a shadow blit.
+//!
+//! Where GL keeps an implicitly "current" context, this keeps an explicit
+//! current target in a thread local, so `Compositor::end_frame` has somewhere to
+//! write without the `Surface` trait growing a pixel accessor.
+
+use std::cell::Cell;
+use std::ffi::c_void;
+use std::fs::OpenOptions;
+use std::os::unix::io::{AsRawFd, RawFd};
+
+use crate::surface::{GfxError, Surface};
+
+const FBIOGET_VSCREENINFO: libc::c_ulong = 0x4600;
+const FBIOPUT_VSCREENINFO: libc::c_ulong = 0x4601;
+const FBIOGET_FSCREENINFO: libc::c_ulong = 0x4602;
+const FBIOPAN_DISPLAY: libc::c_ulong = 0x4606;
+const FBIO_WAITFORVSYNC: libc::c_ulong = 0x4620;
+
+/// Pages given to a file-backed stand-in, matching the Mini Flip's three.
+const FILE_PAGES: u32 = 3;
+
+fn parse_size(s: String) -> Option<(u32, u32)> {
+    let (w, h) = s.split_once('x')?;
+    Some((w.trim().parse().ok()?, h.trim().parse().ok()?))
+}
+
+/// Where `Compositor::end_frame` writes. Set by `make_current`, as a GL context
+/// would be. Raw parts rather than a borrow: the compositor and the surface are
+/// separate objects to the caller and neither owns the other.
+#[derive(Copy, Clone)]
+pub struct Target {
+    pub ptr: *mut u8,
+    pub w: u32,
+    pub h: u32,
+    /// Bytes per row, which is not always `w * 4`.
+    pub stride: usize,
+    pub bgr: bool,
+}
+
+thread_local! {
+    static CURRENT: Cell<Option<Target>> = const { Cell::new(None) };
+}
+
+pub fn current() -> Option<Target> {
+    CURRENT.with(|c| c.get())
+}
+
+fn set_current(t: Option<Target>) {
+    CURRENT.with(|c| c.set(t));
+}
+
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct Bitfield {
+    offset: u32,
+    length: u32,
+    msb_right: u32,
+}
+
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct VarScreenInfo {
+    xres: u32,
+    yres: u32,
+    xres_virtual: u32,
+    yres_virtual: u32,
+    xoffset: u32,
+    yoffset: u32,
+    bits_per_pixel: u32,
+    grayscale: u32,
+    red: Bitfield,
+    green: Bitfield,
+    blue: Bitfield,
+    transp: Bitfield,
+    nonstd: u32,
+    activate: u32,
+    height: u32,
+    width: u32,
+    accel_flags: u32,
+    pixclock: u32,
+    left_margin: u32,
+    right_margin: u32,
+    upper_margin: u32,
+    lower_margin: u32,
+    hsync_len: u32,
+    vsync_len: u32,
+    sync: u32,
+    vmode: u32,
+    rotate: u32,
+    colorspace: u32,
+    reserved: [u32; 4],
+}
+
+#[repr(C)]
+struct FixScreenInfo {
+    id: [u8; 16],
+    smem_start: libc::c_ulong,
+    smem_len: u32,
+    kind: u32,
+    type_aux: u32,
+    visual: u32,
+    xpanstep: u16,
+    ypanstep: u16,
+    ywrapstep: u16,
+    line_length: u32,
+    mmio_start: libc::c_ulong,
+    mmio_len: u32,
+    accel: u32,
+    capabilities: u16,
+    reserved: [u16; 2],
+}
+
+pub struct FbdevSurface {
+    file: std::fs::File,
+    map: *mut u8,
+    map_len: usize,
+    w: u32,
+    h: u32,
+    stride: usize,
+    bgr: bool,
+    /// How many whole screens fit in the mapping, so 3 on the Mini Flip.
+    pages: u32,
+    /// The page `end_frame` draws into; the other one is on screen.
+    back: u32,
+    /// Geometry came from SLOT_FB_SIZE, not a driver, so skip every ioctl.
+    synthetic: bool,
+}
+
+fn ioctl<T>(fd: RawFd, req: libc::c_ulong, arg: &mut T) -> std::io::Result<()> {
+    // SAFETY: `arg` is a correctly-sized struct for `req` in every call below.
+    let rc = unsafe { libc::ioctl(fd, req as _, arg as *mut T as *mut c_void) };
+    if rc < 0 {
+        return Err(std::io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+impl FbdevSurface {
+    pub fn new() -> Result<Self, GfxError> {
+        let path = std::env::var("SLOT_FB").unwrap_or_else(|_| "/dev/fb0".into());
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&path)
+            .map_err(|e| GfxError::Context(format!("{path}: {e}")))?;
+        let fd = file.as_raw_fd();
+
+        let mut var = VarScreenInfo::default();
+        // A plain file plus SLOT_FB_SIZE stands in for a panel, so the renderer
+        // can be driven and its frames inspected off-device. A real framebuffer
+        // never takes this path: the geometry still comes from the driver.
+        if let Some(size) = std::env::var("SLOT_FB_SIZE").ok().and_then(parse_size) {
+            var.xres = size.0;
+            var.yres = size.1;
+            var.xres_virtual = size.0;
+            var.yres_virtual = size.1 * FILE_PAGES;
+            var.bits_per_pixel = 32;
+            var.red.offset = 16;
+            let len = size.0 as u64 * size.1 as u64 * FILE_PAGES as u64 * 4;
+            file.set_len(len)
+                .map_err(|e| GfxError::Context(format!("{path}: set_len: {e}")))?;
+        } else {
+            ioctl(fd, FBIOGET_VSCREENINFO, &mut var)
+                .map_err(|e| GfxError::Context(format!("FBIOGET_VSCREENINFO: {e}")))?;
+        }
+        // SAFETY: zeroed is a valid FixScreenInfo; the driver fills it.
+        let mut fix: FixScreenInfo = unsafe { std::mem::zeroed() };
+        if var.xres == 0 {
+            return Err(GfxError::Context(format!("{path}: driver reports 0 width")));
+        }
+        if std::env::var_os("SLOT_FB_SIZE").is_none() {
+            ioctl(fd, FBIOGET_FSCREENINFO, &mut fix)
+                .map_err(|e| GfxError::Context(format!("FBIOGET_FSCREENINFO: {e}")))?;
+        }
+
+        if var.bits_per_pixel != 32 {
+            return Err(GfxError::Context(format!(
+                "{path}: {} bpp, this backend only does 32",
+                var.bits_per_pixel
+            )));
+        }
+
+        let stride = match fix.line_length {
+            0 => var.xres_virtual as usize * 4,
+            n => n as usize,
+        };
+        // Red at bit 16 means the byte order is BGRA, which is what the Mini
+        // Flip reports and what nearly every 32bpp fbdev panel uses.
+        let bgr = var.red.offset >= 16;
+        let pages = (var.yres_virtual / var.yres.max(1)).max(1);
+        let map_len = stride * var.yres_virtual.max(var.yres) as usize;
+
+        // SAFETY: mapping `map_len` bytes of the framebuffer we just opened.
+        let map = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                map_len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            )
+        };
+        if map == libc::MAP_FAILED {
+            return Err(GfxError::Context(format!(
+                "mmap {path}: {}",
+                std::io::Error::last_os_error()
+            )));
+        }
+
+        let mut me = FbdevSurface {
+            file,
+            map: map as *mut u8,
+            map_len,
+            w: var.xres,
+            h: var.yres,
+            stride,
+            bgr,
+            pages,
+            back: 0,
+            synthetic: std::env::var_os("SLOT_FB_SIZE").is_some(),
+        };
+        // Start on a cleared screen rather than whatever the launcher left.
+        me.clear();
+        me.make_current()?;
+        Ok(me)
+    }
+
+    fn clear(&mut self) {
+        // SAFETY: the whole mapping is ours and writable.
+        unsafe { std::ptr::write_bytes(self.map, 0, self.map_len) };
+    }
+
+    fn page_offset(&self, page: u32) -> usize {
+        self.stride * self.h as usize * page as usize
+    }
+
+    /// True when the driver gave us room for more than one page.
+    pub fn flips(&self) -> bool {
+        self.pages > 1
+    }
+}
+
+impl Surface for FbdevSurface {
+    fn make_current(&mut self) -> Result<(), GfxError> {
+        let off = self.page_offset(self.back);
+        set_current(Some(Target {
+            // SAFETY: `off` is within the mapping by construction of `pages`.
+            ptr: unsafe { self.map.add(off) },
+            w: self.w,
+            h: self.h,
+            stride: self.stride,
+            bgr: self.bgr,
+        }));
+        Ok(())
+    }
+
+    fn window_size(&self) -> (u32, u32) {
+        (self.w, self.h)
+    }
+
+    fn swap(&mut self) -> Result<(), GfxError> {
+        if self.pages == 1 && !self.synthetic {
+            // Nothing to flip to: we drew straight at the scanout. Wait for the
+            // blank so the frame at least lands whole where the driver allows it.
+            let mut arg = 0u32;
+            let _ = ioctl(self.file.as_raw_fd(), FBIO_WAITFORVSYNC, &mut arg);
+            return Ok(());
+        }
+
+        if self.synthetic {
+            self.back = (self.back + 1) % self.pages;
+            return self.make_current();
+        }
+
+        let mut var = VarScreenInfo::default();
+        let fd = self.file.as_raw_fd();
+        ioctl(fd, FBIOGET_VSCREENINFO, &mut var)
+            .map_err(|e| GfxError::Context(format!("FBIOGET_VSCREENINFO: {e}")))?;
+        var.xoffset = 0;
+        var.yoffset = self.h * self.back;
+        // FB_ACTIVATE_VBL: show it at the next blank rather than mid-scanout.
+        var.activate = 0x200;
+        if let Err(e) = ioctl(fd, FBIOPAN_DISPLAY, &mut var) {
+            // Some SigmaStar kernels only accept the pan through PUT_VSCREENINFO.
+            ioctl(fd, FBIOPUT_VSCREENINFO, &mut var)
+                .map_err(|_| GfxError::Context(format!("FBIOPAN_DISPLAY: {e}")))?;
+        }
+
+        self.back = (self.back + 1) % self.pages;
+        self.make_current()
+    }
+
+    fn proc_address(&self, _name: &str) -> *const c_void {
+        // There is no GL here. Nothing in the software path asks for one, and
+        // `Compositor::new` must not call `gl::load` when this backend is built.
+        std::ptr::null()
+    }
+}
+
+impl Drop for FbdevSurface {
+    fn drop(&mut self) {
+        set_current(None);
+        // SAFETY: unmapping exactly what we mapped.
+        unsafe { libc::munmap(self.map as *mut c_void, self.map_len) };
+    }
+}
diff --git a/crates/slot-gfx/src/soft/mod.rs b/crates/slot-gfx/src/soft/mod.rs
new file mode 100644
index 0000000..704b26d
--- /dev/null
+++ b/crates/slot-gfx/src/soft/mod.rs
@@ -0,0 +1,766 @@
+//! Software rendering backend, for devices with a framebuffer and no GPU.
+//!
+//! `lib.rs` exports this module's `Compositor` and `FbdevSurface` under the
+//! `software` feature in place of the GL ones, so nothing above `slot-gfx`
+//! changes: `slot-ui` already emits a `Vec<Draw>` and never touches GL, and
+//! `device_app.rs` names only these two types.
+//!
+//! What is faithful to the GL path:
+//!   - `Draw` coordinates, blending and texture modulation (see `raster.rs`)
+//!   - the game pass's nearest sampling, `u_bright` and the Lcd3x mask, which is
+//!     the same `lcd3x_factors` the shader's `u_mode > 0.5` branch computes
+//!   - the blue-light gain, applied on output as `BLIT_FRAG` does
+//!
+//! What is deliberately not, and why:
+//!   - **Grid, Dot and Simpletex screen effects** fall back to no effect. They
+//!     are multi-tap per-pixel filters; Lcd3x is the default and the only one
+//!     that reduces to a table at integer scale. Revisit once there are frame
+//!     times from the device.
+//!   - **Bezel, frame split and frame lift** are no-ops. All three are gated on
+//!     `bezel::framed()`, which needs a 4:3 panel; the Mini Flip is 752x560
+//!     (2256 != 2240), so the device never reaches them. They are left as
+//!     recorded state so the API matches and a 4:3 target can fill them in.
+//!   - **Panel rotation** (`set_panel_turn`) is accepted and ignored: the Mini
+//!     Flip reports `rotate 0` and a landscape panel.
+
+mod fb;
+mod raster;
+
+pub use fb::FbdevSurface;
+
+use std::f32::consts::PI;
+
+use crate::draw::{Draw, TexId};
+use crate::grade::blue_light_gain;
+use crate::lcd3x::ScreenEffect;
+use crate::pipeline::{SCALE, SRC_H, SRC_W, WHOLE_TEXTURE};
+use crate::power::{screen_brightness, screen_rect};
+use crate::surface::{blit_rect, GfxError, Surface, OUT_H, OUT_W};
+use raster::Image;
+
+pub const BACKDROP: [f32; 4] = [0.0, 0.0, 0.0, 1.0];
+
+// The constants behind lcd3x_factors, which this backend evaluates separably
+// rather than calling per pixel. Kept in step with crate::lcd3x by the test at
+// the bottom of this file, which checks the split against the original.
+const BRIGHTEN_SCANLINES: f32 = 16.0;
+const BRIGHTEN_LCD: f32 = 4.0;
+const LCD_OFFSETS: [f32; 3] = [PI / 2.0, PI * (0.5 - 2.0 / 3.0), PI * (0.5 - 4.0 / 3.0)];
+
+/// Same rule as the GL compositor: an exact integer multiple of the output size
+/// renders at `OUT_W x OUT_H` and is scaled on the way out, anything else
+/// renders at the blit size so nothing is resampled twice.
+pub fn canvas_size(window: (u32, u32)) -> (u32, u32) {
+    let (_, _, w, h) = blit_rect(window, 0.0);
+    let (w, h) = (w.max(1) as u32, h.max(1) as u32);
+    if w % OUT_W == 0 && h % OUT_H == 0 && w / OUT_W == h / OUT_H {
+        (OUT_W, OUT_H)
+    } else {
+        (w, h)
+    }
+}
+
+struct Tex {
+    img: Image,
+}
+
+/// The game plane: a 240x160 frame plus everything `GAME_FRAG` needs.
+struct Game {
+    /// Source frame as RGBA, converted once on upload from the core's XRGB8888.
+    frame: Image,
+    effect: ScreenEffect,
+    power: f32,
+    pic: [f32; 4],
+    src: [f32; 4],
+    fbo_scale: [f32; 2],
+}
+
+impl Game {
+    fn new() -> Self {
+        Game {
+            frame: Image::new(SRC_W, SRC_H),
+            effect: ScreenEffect::Lcd3x,
+            power: 1.0,
+            pic: WHOLE_TEXTURE,
+            src: WHOLE_TEXTURE,
+            fbo_scale: [1.0, 1.0],
+        }
+    }
+
+    /// The core hands us XRGB8888, which is B,G,R,X in memory on little-endian.
+    fn upload(&mut self, xrgb8888: &[u8]) {
+        let want = (SRC_W * SRC_H * 4) as usize;
+        if xrgb8888.len() < want {
+            return;
+        }
+        // XRGB8888 is B, G, R, X in memory on little-endian, which is already
+        // the order the canvas and the panel use: only the alpha needs setting.
+        for (dst, src) in self
+            .frame
+            .px
+            .chunks_exact_mut(4)
+            .zip(xrgb8888[..want].chunks_exact(4))
+        {
+            dst[..3].copy_from_slice(&src[..3]);
+            dst[3] = 255;
+        }
+    }
+
+    fn draw(&self, dst: &mut Image, tex: Option<&Image>) {
+        let img = tex.unwrap_or(&self.frame);
+        let (rx, ry, rw, rh) = screen_rect(self.power);
+        if !(rw > 0.0 && rh > 0.0) || img.w == 0 || img.h == 0 {
+            return;
+        }
+        let src = if tex.is_some() { WHOLE_TEXTURE } else { self.src };
+        let (sw, sh) = (img.w as f32, img.h as f32);
+
+        let x0 = (rx.round() as i32).max(0);
+        let y0 = (ry.round() as i32).max(0);
+        let x1 = ((rx + rw).round() as i32).min(dst.w as i32);
+        let y1 = ((ry + rh).round() as i32).min(dst.h as i32);
+        if x0 >= x1 || y0 >= y1 {
+            return;
+        }
+
+        // The whole inner loop is integer. Everything that varies only with the
+        // column, or only with the row, is computed once into these tables:
+        // without that this does four sin() per pixel through lcd3x_factors,
+        // which is roughly 83 million sin() a second at 60 fps over the game
+        // area, and the Cortex-A7 cannot come close to that.
+        //
+        // The mask is separable, so the split is exact rather than an
+        // approximation: lcd3x_factors is yfactor(y) * xfactor(x) per channel.
+        let lcd = self.effect == ScreenEffect::Lcd3x;
+        let bright = screen_brightness(self.power);
+        let width = (x1 - x0) as usize;
+
+        // Per column: the source texel to read, whether the pic rect includes
+        // it, and the three x factors in 8.8 fixed point.
+        let mut col_texel = vec![0u32; width];
+        let mut col_inside = vec![false; width];
+        let mut col_k = vec![[256u16; 3]; width];
+        for (i, slot) in col_texel.iter_mut().enumerate() {
+            let px = x0 + i as i32;
+            let u = src[0] + (px as f32 + 0.5 - rx) / rw * src[2];
+            *slot = ((u * sw) as i32).clamp(0, img.w as i32 - 1) as u32;
+            col_inside[i] = u >= self.pic[0] && u < self.pic[2];
+            if lcd {
+                // The x half of lcd3x_factors, with yfactor factored out.
+                let fx = (u * sw).fract();
+                for (c, k) in col_k[i].iter_mut().enumerate() {
+                    let o = LCD_OFFSETS[c];
+                    let v = (BRIGHTEN_LCD + (2.0 * PI * fx + o).sin()) / (BRIGHTEN_LCD + 1.0);
+                    *k = (v * 256.0).round().clamp(0.0, 65535.0) as u16;
+                }
+            }
+        }
+
+        let dw = dst.w as usize;
+
+        // The case this device actually runs: a 240x160 frame scaled to exactly
+        // 3x, whole source, whole picture. The mask then has only 3x3 phases, so
+        // every output byte is one table lookup rather than two multiplies and a
+        // shift -- 27 tables of 256 bytes, about 7 KB, which stays in L1.
+        //
+        // The phases line up with lcd3x_mask() by construction: at 3x the
+        // sub-texel centres are (o + 0.5) / 3, which is what it tabulates.
+        let whole = src == WHOLE_TEXTURE && self.pic == WHOLE_TEXTURE;
+        let aligned = rx.fract() == 0.0
+            && ry.fract() == 0.0
+            && rw == sw * SCALE as f32
+            && rh == sh * SCALE as f32;
+        if lcd && whole && aligned {
+            let mask = crate::lcd3x::lcd3x_mask();
+            let mut lut = [[[0u8; 256]; 3]; 9];
+            for oy in 0..3 {
+                for ox in 0..3 {
+                    for c in 0..3 {
+                        // The canvas is in panel order, so byte 0 is blue.
+                        let k = mask[oy][ox][2 - c] * bright;
+                        for (v, out) in lut[oy * 3 + ox][c].iter_mut().enumerate() {
+                            *out = (v as f32 * k).clamp(0.0, 255.0) as u8;
+                        }
+                    }
+                }
+            }
+            let sx0 = (x0 - rx as i32) as usize;
+            for py in y0..y1 {
+                let dy = (py - ry as i32) as usize;
+                let sy = dy / SCALE as usize;
+                let oy = dy % SCALE as usize;
+                let src_row = sy * img.w as usize * 4;
+                let mut di = (py as usize * dw + x0 as usize) * 4;
+                let mut sx = sx0;
+                for _ in 0..(x1 - x0) {
+                    let si = src_row + (sx / SCALE as usize) * 4;
+                    let table = &lut[oy * 3 + sx % SCALE as usize];
+                    for c in 0..3 {
+                        dst.px[di + c] = table[c][img.px[si + c] as usize];
+                    }
+                    dst.px[di + 3] = 255;
+                    di += 4;
+                    sx += 1;
+                }
+            }
+            return;
+        }
+
+        for py in y0..y1 {
+            let v = src[1] + (py as f32 + 0.5 - ry) / rh * src[3];
+            let sy = ((v * sh) as i32).clamp(0, img.h as i32 - 1) as usize;
+            let row_inside = v >= self.pic[1] && v < self.pic[3];
+
+            // The y half of the mask, with brightness folded in so the inner
+            // loop multiplies once per channel and shifts.
+            let yk = if lcd && row_inside {
+                let fy = (v * sh).fract();
+                (BRIGHTEN_SCANLINES + (2.0 * PI * fy).sin()) / (BRIGHTEN_SCANLINES + 1.0) * bright
+            } else {
+                bright
+            };
+            let yk = (yk * 256.0).round().clamp(0.0, 65535.0) as u32;
+
+            let src_row = sy * img.w as usize * 4;
+            let mut di = (py as usize * dw + x0 as usize) * 4;
+            for i in 0..width {
+                let si = src_row + col_texel[i] as usize * 4;
+                let mask = lcd && row_inside && col_inside[i];
+                for c in 0..3 {
+                    let k = if mask { col_k[i][c] as u32 } else { 256 };
+                    // 8.8 x 8.8 over a u8, so shift 16 back down.
+                    let v = (img.px[si + c] as u32 * k * yk) >> 16;
+                    dst.px[di + c] = v.min(255) as u8;
+                }
+                dst.px[di + 3] = 255;
+                di += 4;
+            }
+        }
+    }
+}
+
+/// How the panel is mounted relative to the framebuffer's scan order.
+#[derive(Copy, Clone, PartialEq, Eq)]
+enum Mount {
+    Normal,
+    /// The LCD is fitted upside down, so both axes reverse on the way out.
+    /// The Mini Flip is like this: a frame written top-down appears inverted.
+    Half,
+}
+
+impl Mount {
+    /// `SLOT_FB_ROTATE=180` selects the upside-down panel. Set per device in the
+    /// card's launch script rather than guessed at here.
+    fn from_env() -> Self {
+        match std::env::var("SLOT_FB_ROTATE").as_deref() {
+            Ok("180") => Mount::Half,
+            _ => Mount::Normal,
+        }
+    }
+}
+
+pub struct Compositor {
+    canvas: Image,
+    mount: Mount,
+    /// The last rect written to the panel, and how many more frames must
+    /// repaint the surround. The shake offset moves the rect, and skipping the
+    /// surround then leaves the pixels it vacated on screen -- visible as
+    /// flicker at the edges. One page is cleared per frame, so a change has to
+    /// be followed through every page before the fast path is safe again.
+    last_out: Option<(i32, i32, i32, i32)>,
+    clear_left: u32,
+    textures: Vec<Option<Tex>>,
+    white: TexId,
+    game: Game,
+    gain: [f32; 3],
+    shake: f32,
+    // Recorded for API parity; unreachable on a non-4:3 panel. See the module note.
+    split: Option<f32>,
+    lift: f32,
+    screen: f32,
+    bezel: Option<Image>,
+    turn: Option<((u32, u32), bool)>,
+}
+
+impl Compositor {
+    pub fn new(_surface: &dyn Surface) -> Result<Self, GfxError> {
+        // No gl::load: there is no GL to load. The surface is only here so the
+        // signature matches the GL compositor.
+        let mut me = Compositor {
+            canvas: Image::new(OUT_W, OUT_H),
+            mount: Mount::from_env(),
+            last_out: None,
+            clear_left: 0,
+            textures: Vec::new(),
+            white: TexId::from_raw(0),
+            game: Game::new(),
+            gain: blue_light_gain(0),
+            shake: 0.0,
+            split: None,
+            lift: 1.0,
+            screen: 0.0,
+            bezel: None,
+            turn: None,
+        };
+        me.white = me.create_texture(1, 1, &[255, 255, 255, 255]);
+        Ok(me)
+    }
+
+    pub fn set_panel_turn(&mut self, panel: (u32, u32), ccw: bool) -> Result<(), GfxError> {
+        self.turn = Some((panel, ccw));
+        Ok(())
+    }
+
+    pub fn upload_game(&mut self, xrgb8888: &[u8]) {
+        self.game.upload(xrgb8888);
+    }
+
+    pub fn draw_game(&mut self) {
+        self.game.draw(&mut self.canvas, None);
+    }
+
+    /// Same splitting as the GL compositor: sprites batch up to a `Game` or
+    /// `Shot`, which draws the game plane, then the batch continues.
+    pub fn draw_list(&mut self, items: &[Draw]) {
+        let mut from = 0;
+        for (i, item) in items.iter().enumerate() {
+            match *item {
+                Draw::Game => {
+                    self.draw_sprites(&items[from..i]);
+                    self.game.draw(&mut self.canvas, None);
+                }
+                Draw::Shot { tex } => {
+                    self.draw_sprites(&items[from..i]);
+                    // Borrow the still out of the store so `game` can read it
+                    // while `canvas` is mutably borrowed.
+                    if let Some(img) = self.take_image(tex) {
+                        self.game.draw(&mut self.canvas, Some(&img));
+                        self.put_image(tex, img);
+                    }
+                }
+                _ => continue,
+            }
+            from = i + 1;
+        }
+        self.draw_sprites(&items[from..]);
+    }
+
+    fn take_image(&mut self, id: TexId) -> Option<Image> {
+        self.textures
+            .get_mut(id.raw())?
+            .take()
+            .map(|t: Tex| t.img)
+    }
+
+    fn put_image(&mut self, id: TexId, img: Image) {
+        if let Some(slot) = self.textures.get_mut(id.raw()) {
+            *slot = Some(Tex { img });
+        }
+    }
+
+    fn draw_sprites(&mut self, items: &[Draw]) {
+        for item in items {
+            match *item {
+                Draw::Rect { x, y, w, h, colour } => {
+                    raster::fill_rect(&mut self.canvas, x, y, w, h, raster::to_storage(colour))
+                }
+                Draw::Tex {
+                    x,
+                    y,
+                    w,
+                    h,
+                    tex,
+                    alpha,
+                } => {
+                    if let Some(t) = self.textures.get(tex.raw()).and_then(|t| t.as_ref()) {
+                        raster::blit(
+                            &mut self.canvas,
+                            &t.img,
+                            x,
+                            y,
+                            w,
+                            h,
+                            raster::to_storage([1.0, 1.0, 1.0, alpha]),
+                        );
+                    }
+                }
+                Draw::Turned {
+                    x,
+                    y,
+                    w,
+                    h,
+                    tex,
+                    alpha,
+                    turn,
+                } => {
+                    if let Some(t) = self.textures.get(tex.raw()).and_then(|t| t.as_ref()) {
+                        raster::blit_turned(
+                            &mut self.canvas,
+                            &t.img,
+                            x,
+                            y,
+                            w,
+                            h,
+                            raster::to_storage([1.0, 1.0, 1.0, alpha]),
+                            turn,
+                        );
+                    }
+                }
+                Draw::Game | Draw::Shot { .. } => {}
+            }
+        }
+    }
+
+    pub fn create_texture(&mut self, w: u32, h: u32, rgba: &[u8]) -> TexId {
+        self.textures.push(Some(Tex {
+            img: Image::from_rgba(w, h, rgba),
+        }));
+        TexId::from_raw(self.textures.len() - 1)
+    }
+
+    /// Nearest and linear are the same here: everything is nearest-sampled.
+    /// The UI draws its faces at 1:1, so this costs nothing visible yet.
+    pub fn create_texture_nearest(&mut self, w: u32, h: u32, rgba: &[u8]) -> TexId {
+        self.create_texture(w, h, rgba)
+    }
+
+    pub fn update_texture(&mut self, id: TexId, w: u32, h: u32, rgba: &[u8]) {
+        if let Some(slot) = self.textures.get_mut(id.raw()) {
+            *slot = Some(Tex {
+                img: Image::from_rgba(w, h, rgba),
+            });
+        }
+    }
+
+    pub fn set_blue_light(&mut self, step: u8) {
+        self.gain = blue_light_gain(step);
+    }
+
+    pub fn set_screen_effect(&mut self, effect: ScreenEffect) {
+        self.game.effect = effect;
+    }
+
+    pub fn set_picture(&mut self, rect: [f32; 4]) {
+        self.game.pic = rect;
+    }
+
+    /// The paper texture only feeds the Simpletex effect, which this backend
+    /// does not implement; kept so the API matches.
+    pub fn set_paper(&mut self, _size: u32, _gray: &[u8]) {}
+
+    pub fn fit(&mut self, window: (u32, u32)) {
+        let size = canvas_size(window);
+        if (size.0, size.1) != (self.canvas.w, self.canvas.h) {
+            self.canvas = Image::new(size.0, size.1);
+        }
+    }
+
+    pub fn set_frame_split(&mut self, canvas_y: Option<f32>) {
+        self.split = canvas_y;
+    }
+
+    pub fn set_frame_lift(&mut self, t: f32) {
+        self.lift = t;
+    }
+
+    pub fn set_screen_power(&mut self, t: f32) {
+        self.screen = t;
+        self.game.power = t.clamp(0.0, 1.0);
+    }
+
+    pub fn set_game_source_rect(&mut self, rect: [f32; 4]) {
+        self.game.src = rect;
+    }
+
+    pub fn set_shake(&mut self, dx: f32) {
+        self.shake = dx;
+    }
+
+    /// Top-down RGBA, as the GL path returns after its flip. The canvas is kept
+    /// in panel order, so convert on the way out.
+    pub fn read_frame(&self) -> Vec<u8> {
+        let mut out = self.canvas.px.clone();
+        for p in out.chunks_exact_mut(4) {
+            p.swap(0, 2);
+        }
+        out
+    }
+
+    pub fn begin_frame(&mut self) {
+        self.game.fbo_scale = [
+            self.canvas.w as f32 / OUT_W as f32,
+            self.canvas.h as f32 / OUT_H as f32,
+        ];
+        let b = |v: f32| (v * 255.0).clamp(0.0, 255.0) as u8;
+        self.canvas
+            .fill([b(BACKDROP[0]), b(BACKDROP[1]), b(BACKDROP[2]), 255]);
+    }
+
+    pub fn set_bezel(&mut self, w: u32, h: u32, rgba: &[u8]) {
+        // Stored top-down, unlike the GL path which pre-flips for its FBO.
+        // Unused until a 4:3 panel is supported; see the module note.
+        self.bezel = Some(Image::from_rgba(w, h, rgba));
+    }
+
+    /// Scale the canvas onto the panel and hand it to the framebuffer.
+    ///
+    /// Only the area the canvas lands on is written. The surround is black and
+    /// `FbdevSurface::new` clears every page once, so repainting it each frame
+    /// would be ~75k pixels of wasted work per frame on this panel.
+    pub fn end_frame(&mut self, window: (u32, u32)) {
+        let Some(target) = fb::current() else {
+            return;
+        };
+        let (x, y_gl, w, h) = blit_rect(window, self.shake);
+        // `blit_rect` measures y from the bottom, as a GL viewport does.
+        let y = window.1 as i32 - y_gl - h;
+        if w <= 0 || h <= 0 {
+            return;
+        }
+
+        let (cw, ch) = (self.canvas.w as i32, self.canvas.h as i32);
+        let pw = target.w as i32;
+        let ph = target.h as i32;
+        let half = self.mount == Mount::Half;
+
+        // Repaint the surround only when the image has moved. PAGES is the most
+        // buffers a panel is likely to give us; clearing a few extra frames is
+        // far cheaper than tracking which page is which.
+        const PAGES: u32 = 4;
+        let rect = (x, y, w, h);
+        if self.last_out != Some(rect) {
+            self.last_out = Some(rect);
+            self.clear_left = PAGES;
+        }
+        if self.clear_left > 0 {
+            self.clear_left -= 1;
+            for py in 0..ph {
+                // SAFETY: one row inside the mapping.
+                let row = unsafe {
+                    std::slice::from_raw_parts_mut(
+                        target.ptr.add(py as usize * target.stride),
+                        target.stride,
+                    )
+                };
+                row.fill(0);
+            }
+        }
+
+        // Blue-light gain as a lookup instead of a float multiply per channel
+        // per pixel; at step 0 it is the identity and the copy is straight.
+        let identity = self.gain == [1.0, 1.0, 1.0];
+        let mut lut = [[0u8; 256]; 3];
+        if !identity {
+            for (c, table) in lut.iter_mut().enumerate() {
+                // The canvas is in panel order, so the table for byte 0 is the
+                // blue gain, not the red one.
+                let gain = [self.gain[2], self.gain[1], self.gain[0]][c];
+                for (v, out) in table.iter_mut().enumerate() {
+                    *out = (v as f32 * gain).clamp(0.0, 255.0) as u8;
+                }
+            }
+        }
+
+        let x_start = x.max(0);
+        let x_end = (x + w).min(pw);
+        let y_start = y.max(0);
+        let y_end = (y + h).min(ph);
+        if x_start >= x_end || y_start >= y_end {
+            return;
+        }
+
+        // The case that actually runs on this device: the canvas is exactly the
+        // size of the rect, the panel wants the order the canvas already holds,
+        // and there is no gain. That makes every row a memcpy.
+        // The case that actually runs on this device: the canvas is exactly the
+        // size of the rect, the panel wants the order the canvas already holds,
+        // and there is no gain. The upside-down panel still qualifies -- a 180
+        // degree rotation is just the rows and the pixels within them reversed,
+        // which is a tight copy rather than the general per-pixel path. Leaving
+        // `half` out of this test was worth ~50 ms a frame of nothing, since
+        // this device is always rotated.
+        let one_to_one = w == cw && h == ch && target.bgr && identity;
+        let span = (x_end - x_start) as usize;
+
+        if one_to_one {
+            for py in y_start..y_end {
+                let si = ((py - y) as usize * cw as usize + (x_start - x) as usize) * 4;
+                let Some(src) = self.canvas.px.get(si..si + span * 4) else {
+                    continue;
+                };
+                let dy = if half { ph - 1 - py } else { py };
+                let o = if half {
+                    (pw - x_end) as usize * 4
+                } else {
+                    x_start as usize * 4
+                };
+                // SAFETY: one row inside the mapping.
+                let row = unsafe {
+                    std::slice::from_raw_parts_mut(
+                        target.ptr.add(dy as usize * target.stride),
+                        target.stride,
+                    )
+                };
+                let Some(dst) = row.get_mut(o..o + span * 4) else {
+                    continue;
+                };
+                if half {
+                    // Reverse the row, four bytes at a time. Iterators here so
+                    // the bounds checks fall away.
+                    for (d, s) in dst.chunks_exact_mut(4).zip(src.chunks_exact(4).rev()) {
+                        d.copy_from_slice(s);
+                    }
+                } else {
+                    dst.copy_from_slice(src);
+                }
+            }
+            return;
+        }
+
+        // Source column per destination column, once.
+        let mut col = vec![0usize; span];
+        for (i, slot) in col.iter_mut().enumerate() {
+            let px = x_start + i as i32;
+            *slot = (((px - x) as i64 * cw as i64) / w as i64).clamp(0, cw as i64 - 1) as usize;
+        }
+
+        for py in y_start..y_end {
+            let sy = (((py - y) as i64 * ch as i64) / h as i64).clamp(0, ch as i64 - 1) as usize;
+            let src_row = sy * self.canvas.w as usize * 4;
+            let dy = if half { ph - 1 - py } else { py };
+            // SAFETY: one row inside the mapping, `stride` bytes wide.
+            let row = unsafe {
+                std::slice::from_raw_parts_mut(
+                    target.ptr.add(dy as usize * target.stride),
+                    target.stride,
+                )
+            };
+            for (i, &sx) in col.iter().enumerate() {
+                let px = x_start + i as i32;
+                let dx = if half { pw - 1 - px } else { px } as usize;
+                let o = dx * 4;
+                if o + 4 > row.len() {
+                    continue;
+                }
+                let si = src_row + sx * 4;
+                let mut p = [
+                    self.canvas.px[si],
+                    self.canvas.px[si + 1],
+                    self.canvas.px[si + 2],
+                ];
+                if !identity {
+                    for (c, v) in p.iter_mut().enumerate() {
+                        *v = lut[c][*v as usize];
+                    }
+                }
+                if target.bgr {
+                    row[o..o + 3].copy_from_slice(&p);
+                } else {
+                    row[o] = p[2];
+                    row[o + 1] = p[1];
+                    row[o + 2] = p[0];
+                }
+                row[o + 3] = 255;
+            }
+        }
+        let _ = SCALE;
+    }
+}
