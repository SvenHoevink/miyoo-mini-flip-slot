+#[cfg(test)]
+mod lcd3x_split_tests {
+    use super::{BRIGHTEN_LCD, BRIGHTEN_SCANLINES, LCD_OFFSETS, PI};
+    use crate::lcd3x::lcd3x_factors;
+
+    /// The hot loop multiplies a per-row y factor by a per-column x factor
+    /// instead of calling lcd3x_factors per pixel. That is only legitimate if
+    /// the product is the same function, so pin it.
+    #[test]
+    fn the_separated_mask_equals_lcd3x_factors() {
+        for yi in 0..17 {
+            for xi in 0..17 {
+                let (x, y) = (xi as f32 / 17.0, yi as f32 / 17.0);
+                let yk = (BRIGHTEN_SCANLINES + (2.0 * PI * y).sin()) / (BRIGHTEN_SCANLINES + 1.0);
+                let want = lcd3x_factors(x, y);
+                for c in 0..3 {
+                    let xk = (BRIGHTEN_LCD + (2.0 * PI * x + LCD_OFFSETS[c]).sin())
+                        / (BRIGHTEN_LCD + 1.0);
+                    let got = yk * xk;
+                    assert!(
+                        (got - want[c]).abs() < 1e-6,
+                        "channel {c} at ({x}, {y}): {got} vs {}",
+                        want[c]
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod game_fast_path_tests {
+    use super::{Game, Image, BRIGHTEN_LCD, BRIGHTEN_SCANLINES, LCD_OFFSETS, PI};
+    use crate::pipeline::{SCALE, SRC_H, SRC_W};
+    use crate::surface::{OUT_H, OUT_W};
+
+    /// A frame with every channel varying, so a swapped or truncated channel
+    /// shows up rather than cancelling out.
+    fn frame() -> Vec<u8> {
+        let mut v = Vec::with_capacity((SRC_W * SRC_H * 4) as usize);
+        for y in 0..SRC_H {
+            for x in 0..SRC_W {
+                // XRGB8888 is B, G, R, X in memory.
+                v.push((x % 256) as u8);
+                v.push((y % 256) as u8);
+                v.push(((x + y) % 256) as u8);
+                v.push(0);
+            }
+        }
+        v
+    }
+
+    /// What the separable path computes, in floats, for one output pixel.
+    fn expected(px: u32, py: u32, src: &[u8], c: u32) -> u8 {
+        let (ox, oy) = (px % SCALE, py % SCALE);
+        let (sx, sy) = (px / SCALE, py / SCALE);
+        let (fx, fy) = ((ox as f32 + 0.5) / 3.0, (oy as f32 + 0.5) / 3.0);
+        let yk = (BRIGHTEN_SCANLINES + (2.0 * PI * fy).sin()) / (BRIGHTEN_SCANLINES + 1.0);
+        // Channel c of the stored (panel-order) pixel is colour 2 - c.
+        let xk = (BRIGHTEN_LCD + (2.0 * PI * fx + LCD_OFFSETS[(2 - c) as usize]).sin())
+            / (BRIGHTEN_LCD + 1.0);
+        let v = src[((sy * SRC_W + sx) * 4 + c) as usize] as f32;
+        (v * xk * yk).clamp(0.0, 255.0) as u8
+    }
+
+    #[test]
+    fn the_3x_lookup_matches_the_general_path() {
+        let mut game = Game::new();
+        game.upload(&frame());
+        let mut canvas = Image::new(OUT_W, OUT_H);
+        game.draw(&mut canvas, None);
+
+        let mut worst = 0i32;
+        // Every 3x3 phase, across the frame.
+        for py in (0..OUT_H).step_by(37) {
+            for px in (0..OUT_W).step_by(41) {
+                for c in 0..3u32 {
+                    let got = canvas.px[((py * OUT_W + px) * 4 + c) as usize] as i32;
+                    let want = expected(px, py, &game.frame.px, c) as i32;
+                    worst = worst.max((got - want).abs());
+                }
+            }
+        }
+        // The lookup rounds where the general path truncates in fixed point, so
+        // allow a single level, but no more.
+        assert!(worst <= 1, "lookup path differs from the mask by {worst}");
+    }
+
+    #[test]
+    fn it_actually_wrote_something() {
+        let mut game = Game::new();
+        game.upload(&frame());
+        let mut canvas = Image::new(OUT_W, OUT_H);
+        game.draw(&mut canvas, None);
+        assert!(canvas.px.iter().any(|&b| b != 0), "canvas left blank");
+    }
+}
diff --git a/crates/slot-gfx/src/soft/raster.rs b/crates/slot-gfx/src/soft/raster.rs
new file mode 100644
index 0000000..8e20c55
--- /dev/null
+++ b/crates/slot-gfx/src/soft/raster.rs
@@ -0,0 +1,253 @@
+//! CPU rasteriser for slot's five-variant display list.
+//!
+//! Everything is RGBA8, top-down, premultiplied by nothing: the blend is plain
+//! src-over with the source alpha, matching `SPRITE_FRAG` times
+//! `glBlendFunc(SRC_ALPHA, ONE_MINUS_SRC_ALPHA)`.
+//!
+//! Coordinates match the GL path exactly. `RECT_VERT`/`SPRITE_VERT` map
+//! `u_rect = (x, y, w, h)` through `gl_Position.y = 1 - 2y`, so a `Draw` rect is
+//! in **top-left-origin pixels of the canvas**, which is what this uses
+//! natively. The GL canvas texture is stored bottom-up as a consequence of
+//! being an FBO; ours is top-down, so `read_frame` is a straight copy rather
+//! than a flip.
+
+/// A top-down 8888 image, stored in **the panel's byte order** (B, G, R, A on
+/// every fbdev panel we have seen, this one included), not RGBA.
+///
+/// Keeping the canvas in the order the framebuffer wants makes the output stage
+/// a row memcpy instead of a per-pixel swizzle over the whole frame, which is
+/// the single biggest saving in the backend. Textures are converted once when
+/// they are created rather than on every blit, and `Compositor::read_frame`
+/// converts back, since callers expect RGBA as the GL path returns.
+pub struct Image {
+    pub w: u32,
+    pub h: u32,
+    pub px: Vec<u8>,
+}
+
+impl Image {
+    pub fn new(w: u32, h: u32) -> Self {
+        Image {
+            w,
+            h,
+            px: vec![0; w as usize * h as usize * 4],
+        }
+    }
+
+    /// Takes RGBA, as slot hands it over, and stores panel order.
+    pub fn from_rgba(w: u32, h: u32, rgba: &[u8]) -> Self {
+        let want = w as usize * h as usize * 4;
+        let mut px = rgba.to_vec();
+        px.resize(want, 0);
+        for p in px.chunks_exact_mut(4) {
+            p.swap(0, 2);
+        }
+        Image { w, h, px }
+    }
+
+    pub fn fill(&mut self, rgba: [u8; 4]) {
+        for p in self.px.chunks_exact_mut(4) {
+            p.copy_from_slice(&rgba);
+        }
+    }
+
+    #[inline]
+    fn idx(&self, x: u32, y: u32) -> usize {
+        (y as usize * self.w as usize + x as usize) * 4
+    }
+
+    /// Nearest-neighbour fetch, clamped like `CLAMP_TO_EDGE`.
+    #[inline]
+    pub fn sample(&self, u: f32, v: f32) -> [u8; 4] {
+        if self.w == 0 || self.h == 0 {
+            return [0; 4];
+        }
+        let x = ((u * self.w as f32) as i32).clamp(0, self.w as i32 - 1) as u32;
+        let y = ((v * self.h as f32) as i32).clamp(0, self.h as i32 - 1) as u32;
+        let i = self.idx(x, y);
+        [self.px[i], self.px[i + 1], self.px[i + 2], self.px[i + 3]]
+    }
+}
+
+/// Reorder an RGBA colour to the stored byte order, once per draw call rather
+/// than once per pixel.
+pub fn to_storage(colour: [f32; 4]) -> [f32; 4] {
+    [colour[2], colour[1], colour[0], colour[3]]
+}
+
+/// src-over, both sides straight (non-premultiplied) alpha.
+#[inline]
+fn blend(dst: &mut [u8], src: [u8; 4]) {
+    let a = src[3] as u32;
+    if a == 0 {
+        return;
+    }
+    if a == 255 {
+        dst[0] = src[0];
+        dst[1] = src[1];
+        dst[2] = src[2];
+        dst[3] = 255;
+        return;
+    }
+    let ia = 255 - a;
+    for i in 0..3 {
+        // +127 rounds instead of truncating, which keeps long fade animations
+        // from settling a shade dark.
+        dst[i] = ((src[i] as u32 * a + dst[i] as u32 * ia + 127) / 255) as u8;
+    }
+    dst[3] = (a + dst[3] as u32 * ia / 255).min(255) as u8;
+}
+
+#[inline]
+fn modulate(c: [u8; 4], colour: [f32; 4]) -> [u8; 4] {
+    let f = |v: u8, m: f32| ((v as f32 * m).clamp(0.0, 255.0)) as u8;
+    [
+        f(c[0], colour[0]),
+        f(c[1], colour[1]),
+        f(c[2], colour[2]),
+        f(c[3], colour[3]),
+    ]
+}
+
+/// The clipped integer span of a float rect, as half-open pixel bounds.
+fn clip(dst: &Image, x: f32, y: f32, w: f32, h: f32) -> Option<(i32, i32, i32, i32)> {
+    if !(w > 0.0 && h > 0.0) {
+        return None;
+    }
+    let x0 = x.round() as i32;
+    let y0 = y.round() as i32;
+    let x1 = (x + w).round() as i32;
+    let y1 = (y + h).round() as i32;
+    let cx0 = x0.max(0);
+    let cy0 = y0.max(0);
+    let cx1 = x1.min(dst.w as i32);
+    let cy1 = y1.min(dst.h as i32);
+    if cx0 >= cx1 || cy0 >= cy1 {
+        return None;
+    }
+    Some((cx0, cy0, cx1, cy1))
+}
+
+/// A solid rect. `Draw::Rect` in GL is the 1x1 white texture times `u_colour`,
+/// so this is the same thing without the multiply.
+pub fn fill_rect(dst: &mut Image, x: f32, y: f32, w: f32, h: f32, colour: [f32; 4]) {
+    let Some((x0, y0, x1, y1)) = clip(dst, x, y, w, h) else {
+        return;
+    };
+    // `colour` arrives already in storage order from the caller.
+    let src = modulate([255, 255, 255, 255], colour);
+    for py in y0..y1 {
+        for px in x0..x1 {
+            let i = dst.idx(px as u32, py as u32);
+            blend(&mut dst.px[i..i + 4], src);
+        }
+    }
+}
+
+/// An axis-aligned textured rect, nearest-sampled.
+///
+/// The shelf is several of these a frame, each covering a large part of the
+/// canvas, so the per-pixel work matters as much as the game plane's. The
+/// source column is computed once per column rather than per pixel, and the
+/// two cases that dominate -- a fully transparent texel and a fully opaque one
+/// at full alpha -- skip the blend entirely.
+pub fn blit(dst: &mut Image, tex: &Image, x: f32, y: f32, w: f32, h: f32, colour: [f32; 4]) {
+    let Some((x0, y0, x1, y1)) = clip(dst, x, y, w, h) else {
+        return;
+    };
+    if tex.w == 0 || tex.h == 0 {
+        return;
+    }
+    let plain = colour == [1.0, 1.0, 1.0, 1.0];
+    let width = (x1 - x0) as usize;
+
+    // Source texel per destination column, so the inner loop has no float
+    // divide and no clamp.
+    let mut col = vec![0u32; width];
+    for (i, slot) in col.iter_mut().enumerate() {
+        let px = x0 + i as i32;
+        let u = (px as f32 + 0.5 - x) / w;
+        *slot = ((u * tex.w as f32) as i32).clamp(0, tex.w as i32 - 1) as u32;
+    }
+
+    let dw = dst.w as usize;
+    let tw = tex.w as usize;
+    for py in y0..y1 {
+        let v = (py as f32 + 0.5 - y) / h;
+        let sy = ((v * tex.h as f32) as i32).clamp(0, tex.h as i32 - 1) as usize;
+        let src_row = sy * tw * 4;
+        let mut di = (py as usize * dw + x0 as usize) * 4;
+        for &c in col.iter().take(width) {
+            let si = src_row + c as usize * 4;
+            let a = tex.px[si + 3];
+            if a == 0 {
+                // Cart art is mostly rounded corners and padding; skipping the
+                // blend here is most of the saving on the shelf.
+                di += 4;
+                continue;
+            }
+            if plain && a == 255 {
+                dst.px[di..di + 4].copy_from_slice(&tex.px[si..si + 4]);
+                di += 4;
+                continue;
+            }
+            let mut s = [
+                tex.px[si],
+                tex.px[si + 1],
+                tex.px[si + 2],
+                a,
+            ];
+            if !plain {
+                s = modulate(s, colour);
+            }
+            blend(&mut dst.px[di..di + 4], s);
+            di += 4;
+        }
+    }
+}
+
+/// A textured rect rotated about its own centre, as `Draw::Turned`.
+///
+/// `SPRITE_VERT` rotates the quad's corners by `(cos, sin)` around the rect
+/// centre. Forward-mapping corners would leave seams, so this walks the
+/// destination bounding box and inverse-rotates each pixel back into the rect.
+pub fn blit_turned(
+    dst: &mut Image,
+    tex: &Image,
+    x: f32,
+    y: f32,
+    w: f32,
+    h: f32,
+    colour: [f32; 4],
+    turn: f32,
+) {
+    if turn == 0.0 {
+        blit(dst, tex, x, y, w, h, colour);
+        return;
+    }
+    let (sin, cos) = turn.sin_cos();
+    let (cx, cy) = (x + w * 0.5, y + h * 0.5);
+    // Half-extent of the rotated rect: the bound the inverse map has to cover.
+    let ex = (w * cos.abs() + h * sin.abs()) * 0.5;
+    let ey = (w * sin.abs() + h * cos.abs()) * 0.5;
+    let Some((x0, y0, x1, y1)) = clip(dst, cx - ex, cy - ey, ex * 2.0, ey * 2.0) else {
+        return;
+    };
+    for py in y0..y1 {
+        let dy = py as f32 + 0.5 - cy;
+        for px in x0..x1 {
+            let dx = px as f32 + 0.5 - cx;
+            // Inverse of the forward rotation, so transpose of the matrix.
+            let lx = cos * dx + sin * dy;
+            let ly = -sin * dx + cos * dy;
+            let u = lx / w + 0.5;
+            let v = ly / h + 0.5;
+            if !(0.0..1.0).contains(&u) || !(0.0..1.0).contains(&v) {
+                continue;
+            }
+            let s = modulate(tex.sample(u, v), colour);
+            let i = dst.idx(px as u32, py as u32);
+            blend(&mut dst.px[i..i + 4], s);
+        }
+    }
+}
