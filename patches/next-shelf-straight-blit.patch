+    /// The wallpaper's case: a fully opaque texture drawn at 1:1, which has to
+    /// take the straight path -- the whole saving -- and agree with the
+    /// reference while doing it, whole and clipped.
+    #[test]
+    fn an_unscaled_draw_is_copied_straight_and_matches() {
+        let mut tex = texture(20, 12);
+        for p in tex.px.chunks_exact_mut(4) {
+            p[3] = 255;
+        }
+        let mut scratch = Scratch::default();
+        for (x, y) in [(0.0f32, 0.0f32), (5.0, 3.0), (-7.0, -4.0), (35.0, 30.0)] {
+            for t in [&tex, &texture(20, 12)] {
+                let mut want = canvas(48, 36);
+                let mut got = canvas(48, 36);
+                reference(&mut want, t, x, y, 20.0, 12.0, [1.0, 1.0, 1.0, 1.0]);
+                scratch.straight = 0;
+                super::blit(
+                    &mut got,
+                    t,
+                    x,
+                    y,
+                    20.0,
+                    12.0,
+                    [1.0, 1.0, 1.0, 1.0],
+                    &mut scratch,
+                );
+                assert_eq!(scratch.straight, 1, "at {x},{y} the draw was not straight");
+                assert_eq!(got.px, want.px, "at {x},{y}");
+            }
+        }
+        // And nothing scaled, faded or offset by a fraction is taken for it.
+        for (w, h, a, x) in [
+            (21.0, 12.0, 1.0, 0.0),
+            (20.0, 12.0, 0.5, 0.0),
+            (20.0, 12.0, 1.0, 0.5),
+        ] {
+            scratch.straight = 0;
+            let mut got = canvas(48, 36);
+            super::blit(
+                &mut got,
+                &tex,
+                x,
+                0.0,
+                w,
+                h,
+                [1.0, 1.0, 1.0, a],
+                &mut scratch,
+            );
+            assert_eq!(scratch.straight, 0, "{w}x{h} alpha {a} at {x}");
+        }
+    }
+
     /// The scratch is shared across calls and across frames, so a stale line or
