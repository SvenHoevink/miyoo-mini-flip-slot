#!/bin/sh
export ROOT="/mnt/SDCARD"
export LD_LIBRARY_PATH="/lib:/config/lib:/customer/lib:$ROOT/miyoo:$ROOT/.tmp_update/lib"
export PATH="$ROOT/.tmp_update/bin:$PATH"

# init backlight
echo 0 >/sys/class/pwm/pwmchip0/export
echo 800 >/sys/class/pwm/pwmchip0/pwm0/period
echo 6 >/sys/class/pwm/pwmchip0/pwm0/duty_cycle
echo 1 >/sys/class/pwm/pwmchip0/pwm0/enable

# init lcd
cat /proc/ls
sleep 0.25

# restore timezone
if [ -f $ROOT/.allium/state/timezone ]; then
    export TZ
    TZ="$(cat $ROOT/.allium/state/timezone)"
fi

# perform model-specific logic
if [ -e /dev/input/event1 ]; then
    export MODEL=285

    # Clear loading screen
    show -c

    # Noop /etc/profile
    echo "#!/bin/sh" >/tmp/profile
    mount -o bind /tmp/profile /etc/profile

    # kill default telnetd. Allium will launch its own if needed
    killall telnetd
elif [ -f /customer/app/axp_test ]; then
    export MODEL=354

    # kill default telnetd. Allium will launch its own if needed
    killall telnetd
else
    export MODEL=283

    # init charger detection
    if [ ! -f /sys/devices/gpiochip0/gpio/gpio59/direction ]; then
        echo 59 >/sys/class/gpio/export
        echo in >/sys/devices/gpiochip0/gpio/gpio59/direction
    fi

    # add a loopback address for RA network interface
    ip addr add 127.0.0.1/8 dev lo
    ifconfig lo up
fi

# use audioserver to prevent pop-noise
#
# Skipped when slot is booting, because the server owns MI_AO: it configures the
# device and holds it, so slot's MI_AO_SetPubAttr comes back E_MI_ERR_NOT_PERM,
# "try to change static attribute". Only one of them can have it.
#
# The click every three seconds that this caused the first time round was not
# the server's absence as such -- it was slot's ALSA sink releasing the device
# after three seconds of silence and popping the amplifier each time it
# reopened. The MI_AO sink never releases, so that should not recur. If it does,
# the server goes back and audio stays unsolved.
if [ -f "$ROOT"/.tmp_update/script/start_audioserver.sh ] && [ ! -f "$ROOT"/.slot-boot ]; then
    "$ROOT"/.tmp_update/script/start_audioserver.sh
fi

# run migration scripts that haven't been run yet
for script in "$ROOT"/.allium/migrations/*; do
    if [ ! -f "$script/.done" ]; then
        show -c
        say "$(cat "$script"/name.txt)"
        if ! "$script/run.sh" >"$script/run.log"; then
            # stop everything if migration fails
            show -c
            say "Installation failed. Please reinstall Allium."
            reboot
            sleep 10
        fi
        touch "$script/.done"
    fi
done
show -c

# Boot straight into slot, when asked to.
#
# slot wants the handheld to itself: on the Anbernic machines it *is* the
# launcher, and under Allium its daemon keeps running underneath and claims the
# MENU button, drawing a hotkeys overlay over the game.
#
# Gated on a file so it can be undone from any computer with the card in it,
# with no shell and no telnet: delete /mnt/SDCARD/.slot-boot and Allium comes
# back. If slot exits or fails, execution falls through to Allium below rather
# than leaving a dead handheld.
if [ -f "$ROOT"/.slot-boot ]; then
    # Booting slot means no Allium, and Allium is what used to bring up WiFi,
    # telnet and FTP -- without which the only way to put a new build on the
    # handheld is to carry the card to a computer. So start the network here,
    # in the background so it never delays the frontend, when .slot-net asks.
    if [ -f "$ROOT"/.slot-net ]; then
        # setsid, not just &: backgrounded from here it is still in the boot
        # script's process group, and it stopped after a single attempt rather
        # than retrying -- the same thing that had to be fixed for telnetd.
        setsid "$ROOT"/System/net-up.sh "$ROOT" "$ROOT"/slot-net.txt > /dev/null 2>&1 &
    fi
    # Relaunch slot rather than falling through to Allium when it dies. A
    # crash used to cost about 20 MB on every launch afterwards, because
    # alliumd starts below and stays resident: 60 MB free against 82 on a
    # boot that goes straight to slot. On this handheld that is the margin
    # between a GBA cart playing and being OOM-killed, and it showed up as
    # "the first launch after a reboot lasts two minutes, the next eight
    # seconds".
    #
    # Bounded at three quick deaths so a frontend that cannot start at all
    # still lands on Allium instead of looping forever -- and a launch that
    # lasted a while resets the count, since that death is a fresh story
    # rather than a loop. launch_frontend.sh's own guard unseats the seated
    # cart between attempts, so the second try comes up on the shelf.
    slot_tries=0
    while [ "$slot_tries" -lt 3 ]; do
        slot_began=$(date +%s 2>/dev/null || echo 0)
        SLOT_ROOT="$ROOT" "$ROOT"/System/launch_frontend.sh
        slot_tries=$((slot_tries + 1))
        slot_ended=$(date +%s 2>/dev/null || echo 0)
        if [ "$((slot_ended - slot_began))" -ge 60 ]; then
            slot_tries=0
        else
            # A quick death relaunches, but not instantly. Booting slot is the
            # busiest the handheld gets -- core load, PNG decoding, cart faces
            # on two workers -- and doing it again immediately lands on
            # whatever the last one disturbed. Measured once: a boot where slot
            # was OOM-killed at 93 s and relaunched took three attempts and
            # nearly five minutes to associate the radio, where a quiet boot
            # takes 38 s. A deliberate Restart, which survives a while first,
            # skips this and comes straight back.
            sleep 5
        fi
    done
fi

# run Allium
RUST_LOG=info "$ROOT"/.allium/bin/alliumd >"$ROOT"/allium.log 2>&1

if [ -f "$ROOT"/.debug ]; then
    "$ROOT"/.allium/scripts/wifi-on.sh
    "$ROOT"/.allium/scripts/telnet-on.sh
    while true; do
        sleep 10
    done
else
    while true; do
        reboot
        sleep 10
    done
fi
